#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const readline = require('readline');
const http = require('http');
const { URL } = require('url');
const child_process = require('child_process');
const os = require('os');
const { tuiArgs, switchTui } = require('../lib/ocmux');
const tuiRegistry = require('../lib/tui-registry');
const { listSessions, listProjects: listOpenCodeProjects, createSession, createSessionWithModel, updateSession, listModels, switchModel, resolveModelRef, getAuthHeaders, sortSessionsByRecency, deleteSession, listAgents, getActiveSessions, getSession, listPendingForms, listSessionForms, replyToForm, listPendingPermissions, replyToPermission } = require('../lib/opencode');
const projectState = require('../lib/project-state');

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

const { version } = require('../package.json');

const SCRIPT = path.basename(process.argv[1] || 'ocmux');
const HOME = os.homedir();
const DEFAULT_SERVER = process.env.OCMUX_SERVER || 'http://localhost:4096';

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function findParentStatefile(startDir) {
  let dir = path.resolve(startDir);
  while (true) {
    if (fs.existsSync(path.join(dir, '.ocmux.json'))) {
      return path.join(dir, '.ocmux.json');
    }
    if (dir === HOME || dir === path.dirname(dir)) return null;
    dir = path.dirname(dir);
  }
}

function findParentGitDir(startDir, requireDir) {
  let dir = path.resolve(startDir);
  let stateDir = null;
  while (true) {
    if (!stateDir && fs.existsSync(path.join(dir, '.ocmux.json'))) {
      stateDir = dir;
    }

    const gitPath = path.join(dir, '.git');
    if (fs.existsSync(gitPath)) {
      if (!requireDir) {
        return { dir, stateDir, gitPath };
      }
      try {
        if (fs.statSync(gitPath).isDirectory()) {
          return { dir, stateDir, gitPath };
        }
      } catch {
        // ignore stat errors
      }
    }

    if (dir === HOME || dir === path.dirname(dir)) return { dir: null, stateDir, gitPath: null };
    dir = path.dirname(dir);
  }
}

function resolveGitDir(startDir, requireDir, flagLabel) {
  const result = findParentGitDir(startDir, requireDir);
  if (!result.dir) {
    const label = requireDir ? '.git directory' : '.git entry';
    console.error(`Error: no ${label} found in ${startDir} or any of its parents.`);
    console.error(`Run '${SCRIPT} serve' without ${flagLabel} to initialize the current directory.`);
    process.exit(1);
  }
  return result.dir;
}

function resolveDir(arg) {
  const resolved = path.resolve(arg);
  try {
    if (fs.statSync(resolved).isDirectory()) return resolved;
  } catch {
    // not a valid path or inaccessible
  }
  console.error(`Error: invalid directory '${arg}'`);
  console.error(`Run '${SCRIPT} -h' for help.`);
  process.exit(1);
}

// Health check: is a server answering on `server`? The server is user-managed
// (started with `opencode serve`); this only verifies something is listening.
function checkServer(server) {
  return new Promise((resolve) => {
    let parsed;
    try {
      parsed = new URL(`${server}/api/info`);
    } catch {
      return resolve(false);
    }
    const req = http.request({
      hostname: parsed.hostname,
      port: parsed.port,
      path: parsed.pathname,
      method: 'GET',
      headers: getAuthHeaders(),
    }, (res) => {
      res.resume();
      resolve(true); // any HTTP response means the server is up
    });
    req.setTimeout(3000, () => { req.destroy(); resolve(false); });
    req.on('error', () => resolve(false));
    req.end();
  });
}

// Ask a yes/no question on stderr. Only meaningful on a TTY; resolves false on
// EOF/close so a non-answer never silently changes state.
function askYesNo(question) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
    let done = false;
    const settle = (value) => {
      if (done) return;
      done = true;
      try { rl.close(); } catch {}
      resolve(value);
    };
    rl.question(question, (answer) => settle(/^y(es)?$/i.test((answer || '').trim())));
    rl.on('close', () => settle(false));
  });
}

function refreshTui(directory, server, session) {
  const result = switchTui(directory, server, session, path.resolve(process.argv[1]));
  if (!result.ok && result.reason === 'failed') {
    console.error(`Warning: session selected, but the ${result.kind} TUI could not be refreshed: ${result.error}`);
  }
  return result;
}

async function configuredProjects(server) {
  const [projects, sessions] = await Promise.all([
    listOpenCodeProjects(server),
    listSessions(server),
  ]);
  const rows = [];
  const seen = new Set();
  const directories = [
    ...(projects || []).map(project => project.canonical || project.directory),
    ...(sessions || []).map(session => session.location && session.location.directory),
  ];
  for (const dir of directories) {
    if (!dir) continue;
    let canonical;
    try { canonical = fs.realpathSync(dir); } catch { canonical = path.resolve(dir); }
    if (seen.has(canonical)) continue;
    const sf = path.join(canonical, '.ocmux.json');
    const state = projectState.readProjectState(sf);
    if (!state) continue;
    seen.add(canonical);
    const target = tuiRegistry.resolve(canonical);
    rows.push({
      dir: canonical,
      status: target ? target.kind : 'headless',
      session: state.session,
      server: state.server || server,
    });
  }
  return rows.sort((a, b) => a.dir.localeCompare(b.dir));
}

function newestSessionId(sessions) {
  if (!sessions || sessions.length === 0) return null;
  // Implicit targets skip child/subagent sessions (parentID set) — OpenCode's
  // TUI opens those on its "Subagents" tab instead of the prompt. Callers fall
  // back to creating a session when this returns null.
  const sorted = sortSessionsByRecency(sessions).filter(s => s && s.id && !s.parentID);
  return sorted.length > 0 ? sorted[0].id : null;
}

// ---------------------------------------------------------------------------
// Shared list rendering (scrollable viewport + resize-aware)
// ---------------------------------------------------------------------------

// Visible window for a list rendered in `height` rows around `cursor`.
// Pure (unit-tested). Returns { start, count }.
function windowFor(len, cursor, height) {
  if (len <= 0 || height <= 0) return { start: 0, count: 0 };
  const count = Math.min(len, height);
  if (len <= count) return { start: 0, count };
  let start = cursor - Math.floor(count / 2);
  start = Math.max(0, Math.min(start, len - count));
  return { start, count };
}

// ── Small formatting / layout helpers ──────────────────────────────
function centerIn(s, w) {
  const str = String(s);
  if (str.length >= w) return str.slice(0, w);
  const left = Math.floor((w - str.length) / 2);
  return ' '.repeat(left) + str + ' '.repeat(w - str.length - left);
}
function padLeft(s, w) {
  const str = String(s);
  return ' '.repeat(Math.max(0, w - str.length)) + str;
}

// ── Palette (classic 16-colour ANSI) ─────────────────────────────────────────
// Colour 3 renders as brown/dark-yellow; bold colour 3 as light yellow. The
// whole list UI (title/status bars, cursor pointer, info labels) sticks to these
// two shades so the chrome reads as one theme.
const BROWN = '\x1b[33m';            // text: brown/dark-yellow
const BAR_BG = '\x1b[30;43m';        // title/status bar: black on brown
const LIGHT_YELLOW = '\x1b[1;33m';   // text: light-yellow (bold brown)
const QUESTION_BG = '\x1b[30;103m';  // question/input bar: black on light-yellow

// Pending-state markers shown in the session list rows, the info panel and the
// project switcher. Two INDEPENDENT columns — ❓ pending agent question(s) and
// 🔒 pending permission request(s) — each always reserves a 2-column slot
// (glyph or 2-space placeholder) so every row stays aligned with or without a
// marker. The status bar uses a single 🔔 when any listed session waits.
const GLYPH_FORMS = '❓';     // pending agent question (pending form)
const GLYPH_PERMS = '🔒';    // pending permission request
const GLYPH_BELL = '🔔';     // status bar: at least one marker in the list
const CELL_NONE = '  ';      // placeholder reserving one absent marker column
const PENDING_POLL_MS = 2000; // how often the open picker re-checks pending state

// The two marker columns for a session/project: ❓ and/or 🔒, each column fixed
// at 2 columns wide so rows stay aligned whether or not a marker is present.
function pendingCells(hasForms, hasPerms) {
  return (hasForms ? GLYPH_FORMS : CELL_NONE) + (hasPerms ? GLYPH_PERMS : CELL_NONE);
}

// ── '/' incremental search for interactive lists ──────────────────────────
// Filter `items` by `pattern`: case-insensitive, space-separated tokens that
// must ALL be substrings of `textOf(item)`. Empty pattern → list unchanged.
function filterByPattern(items, pattern, textOf) {
  const p = String(pattern || '').trim().toLowerCase();
  if (!p) return items;
  const tokens = p.split(/\s+/);
  return items.filter((it) => {
    const hay = String(textOf(it) || '').toLowerCase();
    return tokens.every((t) => hay.includes(t));
  });
}

// State of a '/' search line: `active` a filter exists, `live` the user is
// still typing into it, `value` the pattern, `caret` the edit position.
function newSearchState() {
  return { active: false, live: false, value: '', caret: 0 };
}

function clearSearchState(s) {
  s.active = false;
  s.live = false;
  s.value = '';
  s.caret = 0;
}

// Drive a '/' search line from a keypress. Returns:
//   'edit'  — pattern/caret changed (caller re-filters and redraws)
//   'close' — search cancelled/cleared (caller re-filters and redraws)
//   'done'  — search committed, pattern kept (caller redraws)
//   'pass'  — not handled here (caller runs its normal key logic)
function handleSearch(str, key, s) {
  if (str === '/' && !key.ctrl && !key.meta && !s.live) {
    // '/' starts a new search or resumes editing the active filter.
    if (!s.active) { s.value = ''; s.caret = 0; }
    else s.caret = s.value.length;
    s.active = true;
    s.live = true;
    return 'edit';
  }
  if (!s.active) return 'pass';
  if (!s.live) {
    // Committed filter: ESC drops it, Backspace resumes editing it.
    if (key.name === 'escape') { clearSearchState(s); return 'close'; }
    if (key.name === 'backspace') {
      if (s.value === '') { clearSearchState(s); return 'close'; }
      s.live = true;
      s.caret = s.value.length;
      s.value = s.value.slice(0, -1);
      s.caret--;
      return 'edit';
    }
    return 'pass';
  }
  // Live typing.
  if (key.name === 'escape') { clearSearchState(s); return 'close'; }
  if (key.name === 'return' || key.name === 'enter') {
    if (!s.value.trim()) { clearSearchState(s); return 'close'; }
    s.live = false;
    return 'done';
  }
  if (key.name === 'backspace') {
    // Backspace on an already-empty field exits the search (like ESC). Removing
    // the last character keeps the field open.
    if (s.value === '') { clearSearchState(s); return 'close'; }
    if (s.caret > 0) {
      s.value = s.value.slice(0, s.caret - 1) + s.value.slice(s.caret);
      s.caret--;
    }
    return 'edit';
  }
  if (key.name === 'delete' || key.name === 'del') {
    if (s.caret < s.value.length) s.value = s.value.slice(0, s.caret) + s.value.slice(s.caret + 1);
    return 'edit';
  }
  if (key.name === 'left') { s.caret = Math.max(0, s.caret - 1); return 'done'; }
  if (key.name === 'right') { s.caret = Math.min(s.value.length, s.caret + 1); return 'done'; }
  if (key.name === 'home') { s.caret = 0; return 'done'; }
  if (key.name === 'end') { s.caret = s.value.length; return 'done'; }
  if (key.name === 'up' || key.name === 'down') return 'pass'; // navigate the filtered list
  if (str && !key.ctrl && !key.meta && str >= ' ') {
    s.value = s.value.slice(0, s.caret) + str + s.value.slice(s.caret);
    s.caret += str.length;
    return 'edit';
  }
  return 'pass';
}

// The status bar's search line: normal key hints, or the pattern while a '/'
// filter is active (live = input with caret; committed = pattern kept).
// The caller adds the `Enter: confirm · Esc: cancel` hint on the right via
// renderList's `footerRight`.
const SEARCH_HINT = 'Enter: confirm · Esc: cancel';
function searchFooter(s, base) {
  if (!s.active) return base;
  const shown = s.live ? s.value.slice(0, s.caret) + '▏' + s.value.slice(s.caret) : s.value;
  return s.live ? `Search: ${shown}` : `Search: ${shown} · /: edit`;
}

// ── Model picker ordering ─────────────────────────────────────────────────────
// Models sorted by provider then id (the provider already leads the label, so
// this is also alphabetical by display order).
function sortModels(models) {
  const key = (m) => `${String(m.providerID || '').toLowerCase()}/${String(m.id || '').toLowerCase()}`;
  return [...(models || [])].sort((a, b) => (key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0));
}

// Index of `model` (as stored on a session: { providerID, id }) inside
// `models`, or -1 when unknown/unmatched — so a picker can open on it.
function indexOfModel(models, model) {
  if (!model || !models || !models.length) return -1;
  const key = (m) => `${String(m.providerID || '').toLowerCase()}/${String(m.id || '').toLowerCase()}`;
  const target = key(model);
  return models.findIndex((m) => key(m) === target);
}

// Sentinel returned by switchMenu on Ctrl+C so the caller fully exits the CLI
// (instead of just returning to the session menu).
const SWITCH_QUIT = Symbol('ocmux-switch-quit');
// Last-view stamp: HH:MM within the last 24h, else DD/MM/YYYY; '--:--' if unknown.
function fmtClock(ts) {
  if (!ts) return '--:--';
  const d = new Date(ts);
  if (Date.now() - ts < 24 * 3600 * 1000) {
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }
  return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
}
function fmtDuration(ms) {
  const s = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
}
function fmtTokens(n) {
  if (n == null) return null;
  const v = Number(n);
  if (!Number.isFinite(v)) return null;
  if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
  if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
  if (v >= 1e3) return Math.round(v / 1e3) + 'K';
  return String(v);
}
function fmtCost(c) {
  if (c == null) return null;
  const v = Number(c);
  return Number.isFinite(v) ? '$' + v.toFixed(4) : null;
}

// Lay cells out in a responsive grid (row-major), collapsing columns when narrow.
// A cell is a plain string or { label, value } (label rendered bold).
function cellPlain(c) {
  return (c && typeof c === 'object') ? `${c.label}: ${c.value}` : String(c);
}
function cellRender(c, width, labelColor = '\x1b[1m') {
  if (c && typeof c === 'object') {
    const label = `${c.label}:`;
    const avail = Math.max(0, width - label.length - 1);
    let value = String(c.value == null ? '' : c.value);
    if (value.length > avail) value = value.slice(0, avail);
    const plainLen = label.length + 1 + value.length;
    return `${labelColor}${label}\x1b[0m ${value}` + ' '.repeat(Math.max(0, width - plainLen));
  }
  return String(c) + ' '.repeat(Math.max(0, width - String(c).length));
}
function layoutCells(cells, cols, minCell = 26, labelColor = '\x1b[1m') {
  if (!cells || cells.length === 0) return [];
  const plains = cells.map(cellPlain);
  let nCols = Math.max(1, Math.min(cells.length, Math.floor(Math.max(cols, 1) / minCell)));
  const colWidths = (nc) => {
    const w = new Array(nc).fill(0);
    plains.forEach((p, i) => { w[i % nc] = Math.max(w[i % nc], p.length); });
    return w;
  };
  let widths = colWidths(nCols);
  while (nCols > 1 && widths.reduce((a, b) => a + b, 0) + 2 * (nCols - 1) > cols) {
    nCols--;
    widths = colWidths(nCols);
  }
  const nRows = Math.ceil(cells.length / nCols);
  const lines = [];
  for (let r = 0; r < nRows; r++) {
    const parts = [];
    for (let c = 0; c < nCols; c++) {
      const idx = r * nCols + c;
      if (idx >= cells.length) break;
      parts.push(cellRender(cells[idx], widths[c], labelColor));
    }
    lines.push(parts.join('  ').trimEnd());
  }
  return lines;
}

// Bold a label and append a (truncated) value, fitting `cols`.
function labeledLine(label, value, cols, labelColor = '\x1b[1m') {
  const lbl = `${label}:`;
  const avail = Math.max(0, cols - lbl.length - 1);
  let v = String(value == null ? '' : value);
  if (v.length > avail) v = v.slice(0, avail);
  return `${labelColor}${lbl}\x1b[0m ${v}`;
}

// Info lines about the selected session: title + location and a responsive
// grid. Fields are ALWAYS present (placeholders when unknown).
// Labels are brown (the same shade as the title/status bars); when `highlight`
// is true (the cursor is on the session currently selected in the TUI) they are
// light-yellow instead. `pending` (a 2-column-wide marker glyph) is pinned to
// the top-right corner of the panel so the pending state of the CURSOR session
// is visible at a glance.
function sessionInfoLines(s, runningIds, modelContext, cols, highlight = false, pending = '') {
  if (!s) return [];
  const labelColor = highlight ? LIGHT_YELLOW : BROWN;
  const title = (s.title && s.title.trim()) || 'Untitled';
  const location = (s.location && s.location.directory) || 'Unknown';
  // When pending markers are shown they are pinned to the top-right corner:
  // pad the Title line up to `cols - pending.length` (pending is the 4-column
  // two-marker cell, or '' when nothing is pending) and append them.
  const titleLine = `${labelColor}Title:\x1b[0m ${title}`;
  const firstLine = pending
    ? titleLine + ' '.repeat(Math.max(0, cols - pending.length - titleLine.length)) + pending
    : titleLine;
  const out = [
    firstLine,
    labeledLine('Location', location, cols, labelColor),
  ];

  const model = s.model ? `${s.model.providerID}/${s.model.id}` : null;
  const modelLabel = model
    ? model + (s.model.variant && s.model.variant !== 'default' ? '#' + s.model.variant : '')
    : 'Unknown';
  const busy = !!(runningIds && runningIds.has(s.id));
  const since = busy
    ? (s.time && (s.time.updated || s.time.created))
    : (s.time && (s.time.idle || s.time.updated || s.time.created));
  const status = `${busy ? 'BUSY' : 'IDLE'}${since ? ' ' + fmtDuration(Date.now() - since) : ' --:--:--'}`;

  let tokensTxt = '--';
  if (s.tokens) {
    const t = s.tokens;
    const total = (t.input || 0) + (t.output || 0) + (t.reasoning || 0);
    tokensTxt = fmtTokens(total) || '--';
    if (t.cache && t.cache.read) tokensTxt += ' (+' + fmtTokens(t.cache.read) + ' cache)';
  }
  const cost = fmtCost(s.cost) || '--';
  const ctx = (model && modelContext && modelContext.get(model)) ? fmtTokens(modelContext.get(model)) : '--';

  const cells = [
    { label: 'Model', value: modelLabel },
    { label: 'Agent', value: s.agent || 'Unknown' },
    { label: 'Status', value: status },
    { label: 'Tokens', value: tokensTxt },
    { label: 'Cost', value: cost },
    { label: 'Ctx', value: ctx },
    { label: 'Outcome', value: s.outcome || 'Unknown' },
  ];
  return out.concat(layoutCells(cells, cols, 26, labelColor));
}

// Render a scrollable list into the alternate screen.
//   heading    -> centered title bar (brown background)
//   row(index, item) -> string | { text, reverse }
//   extraLines -> prompt/confirm lines right after the list (normal colors)
//   footer     -> status bar (brown background), key hints right-aligned
//                 (left-aligned when footerLeft is set — used by the search line)
//   footerRight-> optional hint pinned to the right end of a left-aligned footer
//   footerBg   -> background for the footer bar (default: BAR_BG; question bars
//                 pass QUESTION_BG so an active prompt stands out)
//   infoLines  -> details below the status bar (colours supplied by the caller)
// A "(start-end/total)" range is appended to the heading when scrolling.
function renderList({ title, items, cursor, row, footer, infoLines = [], extraLines = [], cols: colsArg, rows: rowsArg, footerLeft = false, footerRight = null, footerBg = BAR_BG }) {
  const cols = colsArg || process.stdout.columns || 80;
  const termRows = rowsArg || process.stdout.rows || 24;
  const extras = (extraLines || []).filter((l) => l != null && l !== '');
  const infos = (infoLines || []).filter((l) => l != null && l !== '');

  // Chrome: heading + blank, extras, footer bar, infos.
  const reserved = 2 + extras.length + 1 + infos.length;
  const viewHeight = Math.max(1, termRows - reserved);
  const cursorIdx = items.length ? Math.max(0, Math.min(cursor, items.length - 1)) : 0;
  const win = windowFor(items.length, cursorIdx, viewHeight);

  let titleLine = title;
  if (items.length > win.count) {
    titleLine += `  (${win.start + 1}-${win.start + win.count}/${items.length})`;
  }

  let out = '\x1b[2J\x1b[H';
  out += BAR_BG + centerIn(titleLine, cols) + '\x1b[0m\n\n';

  let rendered = 0;
  if (items.length === 0) {
    out += '  (none)\n';
    rendered = 1;
  } else {
    for (let i = 0; i < win.count; i++) {
      const idx = win.start + i;
      const r = row(idx, items[idx]);
      const text = r && typeof r === 'object' ? r.text : r;
      const reverse = r && typeof r === 'object' && r.reverse;
      // The pointer sits outside the row's own styling so a light-yellow arrow
      // stays visible even on a reverse-video row.
      const ptr = idx === cursor ? `${LIGHT_YELLOW}▶\x1b[0m ` : '  ';
      const body = text == null ? '' : text;
      out += ptr + (reverse ? `\x1b[7m${body}\x1b[0m` : body) + '\n';
      rendered++;
    }
  }
  // Pad the list area so the footer stays pinned to the bottom of the terminal
  // (instead of floating right under the last row on a tall window).
  for (let i = rendered; i < viewHeight; i++) out += '\n';
  for (const l of extras) out += l + '\n';
  let hint;
  if (footerRight) {
    // Left-aligned text plus a hint pinned to the right end of the bar.
    const left = footer.length + footerRight.length + 1 <= cols
      ? footer
      : footer.slice(0, Math.max(0, cols - footerRight.length - 1));
    const gap = Math.max(0, cols - left.length - footerRight.length);
    hint = (left + ' '.repeat(gap) + footerRight).slice(0, cols);
  } else if (footer.length > cols) {
    hint = footer.slice(0, cols);
  } else if (footerLeft) {
    hint = footer + ' '.repeat(cols - footer.length);
  } else {
    hint = padLeft(footer, cols);
  }
  out += footerBg + hint + '\x1b[0m\n';
  for (const l of infos) out += l + '\n';
  return out.replace(/\n$/, '');
}

// Render an interactive session picker (alt screen). Sorted most-recently-viewed
// first by the caller. Keys: Enter/Space switch (menu stays open), n create,
// r rename, d delete (confirm), a annotate, p switch project, A answer the
// cursor session's pending questions, P answer its permission requests, h help,
// q/Ctrl+C quit. Input mode offers readline-style caret editing.
// Resolves on quit (null) or with the string 'switch-project' (caller then runs
// the project switcher and re-invokes this picker for the new project).
// `dir` names the project this list belongs to — it heads the title bar so a
// multi-project run always says which project's sessions are on screen.
// `loadPending` (optional async () => ({ forms: Set, perms: Set })) supplies the
// session ids that currently await an agent question (pending form) or a
// permission reply. When provided the picker polls it every PENDING_POLL_MS and
// renders the ❓/🔒 marker columns; `A` answers the cursor session's questions
// and `P` its pending permission requests (allow once/always, reject).
function sessionMenu(sessions, currentSession, annotations, server, { onPick, onRename, onDelete, onReminder, runningIds, modelContext, onBroadcastChange, onInspectSession, dir, notices = [], loadPending, broadcast = null } = {}) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) return resolve(null);

    let rows = [...sessions];
    let current = currentSession;
    let cursor = 0;
    let mode = 'normal';        // 'normal' | 'help' | 'confirm' | 'input' | 'perm' | 'perm-help'
    let confirmDel = null;
    let confirmAll = false;     // 'D' deletes every broadcast-selected session
    let input = null;           // { label, value, kind, caret }
    let list = null;            // { title, items, format, onEnter }
    let listCursor = 0;
    let done = false;
    const SPINNER = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
    let spinIdx = 0;
    let spinTimer = null;
    let broadcastSel = new Set(); // session ids selected in broadcast mode
    let search = newSearchState();    // '/' filter for the session list
    let listSearch = newSearchState(); // '/' filter for inline lists (models/agents)
    let view = rows;              // rows filtered by `search` (what is displayed)
    let inspected = false;        // broadcast inspection moved the TUI off `current`

    // Adopt a persisted broadcast selection, but only when it is still valid:
    // at least two of its ids must name existing sessions in this project's
    // list (main sessions only — the caller already excluded child sessions).
    // A stale list (too few entries, or ids that no longer exist) is cleared and
    // the correction written back, so the picker never shows a normal list while
    // agentp would still broadcast to the old one.
    const persistedBroadcast = (Array.isArray(broadcast) ? broadcast : [])
      .map(String)
      .filter((id, i, arr) => arr.indexOf(id) === i)
      .filter((id) => rows.some((s) => String(s.id) === id));
    if (persistedBroadcast.length >= 2) {
      broadcastSel = new Set(persistedBroadcast);
      mode = 'broadcast';
      // Anchor the picker (and the TUI) on a session that is actually selected.
      if (!broadcastSel.has(String(current))) {
        current = persistedBroadcast[0];
        if (onInspectSession) onInspectSession(current);
      }
      // Write back when validation dropped dead or duplicate ids.
      if (onBroadcastChange && persistedBroadcast.length !== (Array.isArray(broadcast) ? broadcast.length : 0)) {
        onBroadcastChange(persistedBroadcast);
      }
    } else if (onBroadcastChange && Array.isArray(broadcast) && broadcast.length > 0) {
      // Stale or invalid persisted list: clear it so agentp stops broadcasting.
      onBroadcastChange([]);
    }

    // Pending agent questions / permission replies, polled via `loadPending`.
    // Each is a Set of session ids that currently await that thing.
    let pendingForms = new Set();
    let pendingPerms = new Set();
    let pendingBusy = false;
    let pendingTimer = null;
    // Answer mode ('A') state: the pending forms of the cursor session being
    // answered one at a time, the answers chosen so far and the flat item list.
    let answer = null;
    // Permission mode ('P') state: the pending permission request(s) of the
    // cursor session being answered one at a time.
    let perm = null;
    // The two marker columns (❓ and/or 🔒), always 4 columns wide — each in a
    // fixed 2-column slot — so rows stay aligned with or without a marker.
    const cellsOf = (id) => pendingCells(pendingForms.has(String(id)), pendingPerms.has(String(id)));

    const pad = (s, w) => s + ' '.repeat(Math.max(0, w - s.length));
    const helpLines = [
      'Enter            switch to the selected session (stays open)',
      'Space            start BROADCAST: add the selected session to the current one',
      '                 (Space toggles each session; Enter ends broadcast and',
      '                  switches; ESC/q also end it and clear the selection)',
      'n                create a new session (type a name, Enter; blank = auto)',
      'r                rename the selected session (edit in place; ESC cancels)',
      'R (Shift+r)      set a REMINDER for the selected session (sent in front of',
      '                  every agentp prompt; blank clears)',
      'd                delete the selected session (then y/N to confirm)',
      'D (Shift+d)      in BROADCAST: delete ALL selected sessions (then y/N)',
      'A                answer pending agent question(s) of the selected session',
      '                 (only when it shows a ❓ marker)',
      'P                answer pending permission request(s) of the selected session',
      '                 (only when it shows a 🔒 marker)',
      'a                switch the AGENT of the selected session',
      'm                switch the MODEL of the selected session',
      'p                open the project switcher',
      '/                search/filter this list (Enter keeps the filter,',
      '                 ESC clears it, / resumes editing it)',
      'j / k, arrows    move the cursor',
      'h                toggle this help',
      'q / Ctrl+C       quit',
      '',
      'While typing (n/r/R):',
      '  left/right, Home/End   move the caret',
      '  Backspace / Delete     edit in place',
      '  Enter                  confirm, ESC cancels',
    ];

    const cleanup = () => {
      process.stderr.write('\x1b[?25h');
      process.stderr.write('\x1b[?1049l');
      if (spinTimer) { clearInterval(spinTimer); spinTimer = null; }
      if (pendingTimer) { clearInterval(pendingTimer); pendingTimer = null; }
      process.stdout.removeListener('resize', draw);
      try { process.stdin.setRawMode(false); } catch {}
      process.stdin.pause();
    };
    const finish = (value) => {
      if (done) return;
      done = true;
      cleanup();
      process.stdin.removeAllListeners('keypress');
      process.removeListener('SIGINT', onSig);
      resolve(value);
    };
    const onSig = () => finish(null);
    process.on('SIGINT', onSig);

    const renderInputValue = (v) => {
      const c = input.caret;
      return v.slice(0, c) + '▏' + v.slice(c);
    };

    const draw = () => {
      if (answer && (mode === 'answer' || mode === 'answer-help' || (mode === 'input' && input && input.kind === 'answer'))) {
        drawAnswer();
        return;
      }
      if (perm && (mode === 'perm' || mode === 'perm-help')) {
        drawPerm();
        return;
      }
      if (mode === 'help' || mode === 'broadcast-help' || mode === 'list-help') {
        let out = '\x1b[2J\x1b[H';
        if (mode === 'broadcast-help') {
          out += 'ocmux broadcast mode — help\n\n';
          out += '  Space            select/deselect the cursor session\n';
          out += '  Enter            end broadcast (clear the selection); switch TUI to cursor\n';
          out += '  m                switch the model for ALL selected sessions\n';
          out += '  d                delete the cursor session (with confirmation)\n';
          out += '  D (Shift+d)      delete ALL selected sessions (with confirmation)\n';
          out += '  j / k, arrows    move the cursor (selecting shows it in the TUI)\n';
          out += '  /                search/filter the session list\n';
          out += '  ESC / q          cancel broadcast mode (back to the session list)\n';
          out += '  Ctrl+C           quit ocmux\n';
        } else if (mode === 'list-help') {
          out += `ocmux ${list && list.title ? list.title : 'list'} — help\n\n`;
          out += '  j / k, arrows    move the cursor\n';
          out += '  Enter / Space    select the highlighted item\n';
          out += '  /                search/filter the list (Enter keeps, ESC clears)\n';
          out += '  h                toggle this help\n';
          out += '  ESC / q / Backspace   return to the previous menu\n';
          out += '  Ctrl+C           quit ocmux\n';
        } else {
          out += 'ocmux session picker — help\n\n';
          for (const l of helpLines) out += '  ' + l + '\n';
        }
        out += '\nPress any key to return.\n';
        process.stderr.write(out);
        return;
      }
      if (mode === 'list' && list) {
        const listExtras = (listSearch.active && list.view.length === 0) ? [`No matches for "${listSearch.value}"`] : [];
        process.stderr.write(renderList({
          title: `ocmux — ${list.title}`,
          items: list.view,
          cursor: listCursor,
          row: (i, item) => list.format(item) || '',
          footer: searchFooter(listSearch, 'Enter: select · /: search · h: help · ESC: back'),
          footerLeft: listSearch.active,
          footerRight: listSearch.active ? SEARCH_HINT : null,
          extraLines: listExtras,
        }));
        return;
      }
      const cols = process.stdout.columns || 80;
      const showTime = cols >= 48;
      const TIME_W = 10; // dd/mm/yyyy worst case
      const maxLen = Math.min(
        Math.max(...rows.map(s => (s.title || s.id || '').length), 8) + 6,
        Math.max(8, cols - (showTime ? TIME_W + 10 : 8)),
      );
      const inBc = mode === 'broadcast' || mode === 'broadcast-confirm';
      const extras = [...notices];
      if (search.active && view.length === 0) extras.push(`No sessions match "${search.value}"`);
      const selected = view[cursor];
      let infoLines = [];
      let footer = 'Enter: switch · Space: broadcast · /: search · h: help · q: quit';
      let footerLeft = search.active;
      let footerRight = search.active ? SEARCH_HINT : null;
      if (inBc) {
        // List every selected session, capped so the info line never wraps. On
        // overflow the head is trimmed and marked with '...' — the picker lists
        // most-recently-viewed first, so the trimmed head is the most recently
        // viewed part of the selection.
        let names = rows.filter(r => broadcastSel.has(String(r.id))).map(r => r.title || r.id).join(', ');
        const bcHead = 'Broadcast to sessions: ';
        const budget = Math.max(8, Math.min(480, cols - bcHead.length));
        if (names.length > budget) {
          let keep = names.slice(-(budget - 4)); // 3 for '...', 1 for the space
          const at = keep.indexOf(', ');
          if (at > 0) keep = keep.slice(at + 2);
          names = '... ' + keep;
        }
        infoLines = [bcHead + names];
        footer = 'Enter: switch (ends) · Space: toggle · d: delete · D: delete all · m: model · /: search · h: help · q: cancel · Ctrl+C: quit';
      } else {
        const selIsCurrent = !!(selected && String(selected.id) === String(current));
        // The cursor session's marker columns (❓/🔒) are pinned to the info
        // panel's top-right corner ('' when nothing is pending).
        const selF = selected && pendingForms.has(String(selected.id));
        const selP = selected && pendingPerms.has(String(selected.id));
        const selPending = (selF || selP) ? pendingCells(selF, selP) : '';
        infoLines = sessionInfoLines(selected, runningIds, modelContext, cols, selIsCurrent, selPending);
      }
      // 'd'/n/r/R prompts take over the status bar (previously an easy-to-miss
      // line at the bottom of the list) with their essential keys on the right.
      // A prompt also flips the bar to light yellow, matching the list pointer,
      // so the change of state is obvious at a glance.
      let questionBar = false;
      if ((mode === 'confirm' || mode === 'broadcast-confirm') && confirmDel) {
        questionBar = true;
        if (confirmAll) {
          const n = broadcastSel.size;
          footer = `Delete all ${n} selected session${n === 1 ? '' : 's'}?`;
        } else {
          footer = `Delete session "${confirmDel.title || confirmDel.id || ''}"?`;
        }
        footerLeft = true;
        footerRight = 'y: delete · n/Esc: cancel';
      } else if (mode === 'input' && input) {
        questionBar = true;
        footer = `${input.prompt} ${renderInputValue(input.value)}`;
        footerLeft = true;
        footerRight = input.hint;
      } else {
        footer = searchFooter(search, footer);
      }
      // Pending-response awareness: when any session in this list is waiting
      // for an agent question and/or a permission reply, lead the status bar
      // with the bell (🔔) and flip the bar left-aligned so it sits at the very
      // beginning.
      if (!questionBar) {
        const anyF = rows.some(r => pendingForms.has(String(r.id)));
        const anyP = rows.some(r => pendingPerms.has(String(r.id)));
        const bell = (anyF || anyP) ? GLYPH_BELL : '';
        if (bell && footer.length < cols - 4) {
          footer = `${bell} ${footer}`;
          footerLeft = true;
        }
      }
      process.stderr.write(renderList({
        // The project name heads the title so you always know which project's
        // sessions are listed (matters when --all-projects moves you around).
        title: dir ? `ocmux — ${path.basename(dir)} sessions` : 'ocmux — sessions',
        items: view,
        cursor,
        row: (i, s) => {
          const sel = inBc ? (broadcastSel.has(String(s.id)) ? '[x] ' : '[ ] ') : '';
          const title = (s.title || s.id || '').slice(0, maxLen);
          const timeStr = showTime ? padLeft(fmtClock(s.time && s.time.viewed), TIME_W) + '  ' : '';
          const mark = String(s.id) === String(current) ? ' *' : '';
          const hasNote = annotations && annotations[s.id] ? ' ◈' : '';
          const spin = (runningIds && runningIds.has(s.id)) ? SPINNER[spinIdx % SPINNER.length] + ' ' : '  ';
          const text = `${sel}${spin}${cellsOf(s.id)}${timeStr}${pad(title, maxLen)}${mark}${hasNote}`;
          // Brown for the session currently selected in the TUI window.
          return String(s.id) === String(current) ? `${BROWN}${text}\x1b[0m` : text;
        },
        footer,
        footerLeft,
        footerRight,
        footerBg: questionBar ? QUESTION_BG : BAR_BG,
        infoLines,
        extraLines: extras,
      }));
    };

    const startInput = (prompt, hint, value, kind, targetKey) => {
      input = { prompt, hint, value, kind, targetKey, caret: value.length };
      mode = 'input';
      draw();
    };

    const applyRenameWith = (name) => {
      const row = view[cursor];
      if (!row || !onRename || !name) return;
      Promise.resolve(onRename(row, name)).then((updated) => {
        row.title = (updated && updated.title) || name;
        draw();
      }).catch((err) => {
        process.stderr.write(`\nError: ${err.message}\n`);
        draw();
      });
    };

    const applyReminder = (text) => {
      const row = view[cursor];
      if (!row || !onReminder) return;
      Promise.resolve(onReminder(row, text)).then((saved) => {
        if (saved) annotations[row.id] = saved;
        else delete annotations[row.id];
        draw();
      }).catch((err) => {
        process.stderr.write(`\nError: ${err.message}\n`);
        draw();
      });
    };

    const applyPick = (row) => {
      // Selecting a session always drops any persisted broadcast list: a stale
      // 'broadcast' in .ocmux.json would otherwise keep agentp sending prompts
      // to sessions that are no longer selected.
      persistBroadcast([]);
      broadcastSel = new Set();
      Promise.resolve(onPick ? onPick(row) : null).then((created) => {
        if (row.new && created) {
          rows.unshift(created);
          applySearch();
          const ci = view.indexOf(created);
          cursor = ci >= 0 ? ci : 0;
          current = created.id;
        } else if (!row.new) {
          current = row.id;
        }
        inspected = false;
        confirmDel = null;
        confirmAll = false;
        draw();
      }).catch((err) => {
        process.stderr.write(`\nError: ${err.message}\n`);
        confirmDel = null;
        confirmAll = false;
        draw();
      });
    };

    // ── Pending-response polling (❓/🔒 marker columns) ─────────────
    // Re-read `loadPending` every PENDING_POLL_MS while the picker is open so
    // the markers appear/disappear without re-opening the menu. Errors degrade
    // gracefully: the previous set stays and the next poll retries.
    const refreshPending = () => {
      if (!loadPending || pendingBusy) return Promise.resolve();
      pendingBusy = true;
      return Promise.resolve(loadPending()).then((p) => {
        pendingForms = (p && p.forms) || new Set();
        pendingPerms = (p && p.perms) || new Set();
        pendingBusy = false;
        if (!done) draw();
      }).catch(() => { pendingBusy = false; });
    };

    // ── Answer mode (A): answer the agent's pending form(s) ─────────
    // Field applicability honours `hidden` and `when` conditions over the
    // answers chosen SO FAR (live re-validation: groups appear/disappear as you
    // answer their gate questions).
    const fieldVisible = (field) => {
      if (!field || field.hidden) return false;
      if (!Array.isArray(field.when) || field.when.length === 0) return true;
      return field.when.every((w) => {
        const got = answer.answers[w.key];
        if (got === undefined || got === null) return false;
        // For multiselect gates `eq` means the value is among the chosen ones.
        const matches = Array.isArray(got) ? got.includes(w.value) : got === w.value;
        return (w.op === 'neq') ? !matches : matches;
      });
    };
    const fieldOptions = (field) => {
      if (field.type === 'boolean') {
        return [{ label: 'Yes', value: true }, { label: 'No', value: false }];
      }
      if (field.type === 'string' || field.type === 'multiselect') {
        return Array.isArray(field.options) ? field.options : [];
      }
      return [];
    };
    const knownValues = (field) => new Set((field.options || []).map(o => String(o.value)));
    // The custom text (if any) behind "Type your own answer" — distinguishes a
    // typed answer from a chosen option for single-choice and multiselect.
    const customText = (field) => {
      const v = answer.answers[field.key];
      if (v === undefined || v === null) return null;
      if (Array.isArray(v)) {
        const extra = v.filter(x => !knownValues(field).has(String(x)));
        return extra.length ? extra.join(', ') : null;
      }
      return knownValues(field).has(String(v)) ? null : String(v);
    };
    const isSelected = (field, opt) => {
      const v = answer.answers[field.key];
      if (v === undefined || v === null) return false;
      if (Array.isArray(v)) return v.some(x => String(x) === String(opt.value));
      return String(v) === String(opt.value);
    };
    const toggleSelect = (field, opt) => {
      if (field.type === 'multiselect') {
        const arr = Array.isArray(answer.answers[field.key]) ? [...answer.answers[field.key]] : [];
        const i = arr.findIndex(x => String(x) === String(opt.value));
        if (i >= 0) arr.splice(i, 1); else arr.push(opt.value);
        answer.answers[field.key] = arr;
      } else {
        answer.answers[field.key] = opt.value;
      }
      answer.error = null;
    };
    // Save a typed value (custom / free-text / numeric field). No client-side
    // validation beyond numeric coercion — the server decides and its message
    // is shown in the status bar.
    const applyAnswerValue = (fieldKey, raw) => {
      const form = answer.forms[answer.index];
      const field = (form.fields || []).find(f => f.key === fieldKey);
      const v = raw.trim();
      if (!v) {
        delete answer.answers[fieldKey];
      } else if (field && (field.type === 'number' || field.type === 'integer')) {
        const num = Number(v);
        answer.answers[fieldKey] = Number.isNaN(num) ? v : num;
      } else if (field && field.type === 'multiselect') {
        // Keep the built-in selections and replace any custom entries with the
        // newly typed value.
        const known = knownValues(field);
        const base = Array.isArray(answer.answers[fieldKey]) ? answer.answers[fieldKey].filter(x => known.has(String(x))) : [];
        base.push(v);
        answer.answers[fieldKey] = base;
      } else {
        answer.answers[fieldKey] = v;
      }
      answer.error = null;
    };
    // Prefill `default` values once per form, before the user starts editing
    // (rebuilt answers never clobber what was already chosen).
    const seedDefaults = () => {
      const form = answer.forms[answer.index];
      if (!form || !Array.isArray(form.fields)) return;
      for (const f of form.fields) {
        if (fieldVisible(f) && f.default !== undefined && f.default !== null && answer.answers[f.key] === undefined) {
          answer.answers[f.key] = f.default;
        }
      }
    };
    // Flat list of *visible* rows for the current form: a section header per
    // applicable field, one row per option (or a single type-in row for
    // free-text/numeric fields), then the Submit row.
    const buildAnswerItems = (form) => {
      const items = [];
      for (const field of (form.fields || []).filter(fieldVisible)) {
        if (field.type === 'external') {
          items.push({ kind: 'external', field });
          continue;
        }
        items.push({ kind: 'field', field });
        const opts = fieldOptions(field);
        for (const opt of opts) items.push({ kind: 'option', field, opt });
        const wantTypedRow = opts.length === 0 || ((field.type === 'string' || field.type === 'multiselect') && field.custom);
        if (wantTypedRow) {
          items.push({ kind: 'option', field, opt: null, custom: !!field.custom, inputOnly: opts.length === 0 });
        }
      }
      items.push({ kind: 'submit' });
      return items;
    };
    const answerItems = () => {
      const form = answer.forms[answer.index];
      return form ? buildAnswerItems(form) : [];
    };
    const isAnswerClickable = (item) => item && (item.kind === 'option' || item.kind === 'submit');
    // After a `when` re-validation some rows disappear; keep the cursor on a
    // selectable row (called from drawAnswer so the frame always self-heals).
    const clampAnswerCursor = () => {
      const items = answerItems();
      if (!items.length) { answer.cursor = 0; return; }
      if (isAnswerClickable(items[answer.cursor])) return;
      for (let off = 1; off < items.length; off++) {
        const i = (answer.cursor + off) % items.length;
        if (isAnswerClickable(items[i])) { answer.cursor = i; return; }
      }
      answer.cursor = 0;
    };
    const moveAnswerCursor = (delta) => {
      const items = answerItems();
      const n = items.length;
      if (!n) return;
      let i = answer.cursor;
      do {
        i = (i + delta + n) % n;
      } while (!isAnswerClickable(items[i]) && i !== answer.cursor);
      answer.cursor = i;
      draw();
    };
    const activateOption = (item) => {
      if (item.inputOnly || item.custom) {
        // Open the text input (custom answer / free-text / numeric field).
        const label = item.field.title || item.field.key;
        const cur = (item.inputOnly && answer.answers[item.field.key] !== undefined)
          ? String(answer.answers[item.field.key])
          : (item.custom ? (customText(item.field) || '') : '');
        startInput(`Answer for "${label}":`, 'Enter: save · Esc: cancel', cur, 'answer', item.field.key);
        return;
      }
      toggleSelect(item.field, item.opt);
      draw();
    };
    const submitAnswer = () => {
      if (answer.busy) return;
      const form = answer.forms[answer.index];
      if (!form) return;
      answer.busy = true;
      answer.error = null;
      draw();
      replyToForm(server, form.sessionID, form.id, answer.answers).then(() => {
        answer.busy = false;
        return listSessionForms(server, form.sessionID).then((forms) => {
          if (!forms || forms.length === 0) {
            // All questions answered — back to the session list (marker clears
            // after the pending set is re-polled).
            answer = null;
            mode = 'normal';
            notices.push('✔ Answers submitted.');
            return refreshPending();
          }
          // Move on to the session's next pending form.
          answer.forms = forms;
          answer.index = 0;
          answer.answers = {};
          answer.cursor = 0;
          answer.error = null;
          seedDefaults();
          draw();
          return refreshPending();
        });
      }).catch((err) => {
        answer.busy = false;
        if (err && err.status === 409) {
          // Answered elsewhere (e.g. from the TUI) while we were editing.
          answer = null;
          mode = 'normal';
          notices.push(err.message || 'Already answered.');
          return refreshPending();
        }
        // The server rejected the answers — surface its message in the status
        // bar and stay in answer mode so the user can adjust.
        answer.error = (err && err.message) || 'Failed to submit answers.';
        draw();
      });
    };
    const startAnswer = (target) => {
      listSessionForms(server, target.id).then((forms) => {
        if (!forms || forms.length === 0) { draw(); return; }
        answer = {
          forms,
          index: 0,
          answers: {},
          cursor: 0,
          error: null,
          busy: false,
          title: (target.title && target.title.trim()) || target.id || 'session',
        };
        seedDefaults();
        mode = 'answer';
        draw();
      }).catch(commandErr);
    };
    const renderAnswerItem = (item, cols) => {
      if (item.kind === 'field') {
        const label = (item.field.title || item.field.key).slice(0, Math.max(4, cols - 6));
        const req = item.field.required ? ' *' : '';
        return `${BROWN}▸ ${label}${req}\x1b[0m`;
      }
      if (item.kind === 'external') {
        const label = (item.field.title || item.field.key).slice(0, Math.max(4, cols - 6));
        return `  ⛓ ${label} (external link, can't be answered here)`;
      }
      if (item.kind === 'submit') {
        const fields = answerItems().filter(i => i.kind === 'field');
        const done = fields.filter(i => answer.answers[i.field.key] !== undefined).length;
        const total = fields.length;
        const tally = total > 0 ? ` (${done}/${total} answered)` : '';
        return `  ${done === total && total > 0 ? '✓' : ' '} Submit answers${tally}`;
      }
      // Option / custom / free-text row.
      let selected;
      let label;
      if (item.custom) {
        const cv = customText(item.field);
        selected = cv !== null;
        label = selected ? `Custom: ${cv}` : 'Type your own answer';
      } else if (item.inputOnly) {
        const v = answer.answers[item.field.key];
        selected = v !== undefined;
        label = selected ? String(v) : (item.field.placeholder || 'Type your answer');
      } else {
        selected = isSelected(item.field, item.opt);
        label = item.opt.label;
      }
      const prefix = selected ? '(•)' : '( )';
      return `  ${prefix} ${String(label).slice(0, Math.max(4, cols - 10))}`;
    };
    const drawAnswer = () => {
      let out = '\x1b[2J\x1b[H';
      if (mode === 'answer-help') {
        out += 'ocmux — answer mode help\n\n';
        out += '  j / k, arrows    move between the questions and their options\n';
        out += '  Space / Enter    select an option (extra entries toggle on\n';
        out += '                   multi-select questions); on "Type your own\n';
        out += '                   answer" / free-text rows it opens the input\n';
        out += '  Submit answers   the last row: send all answers in one request\n';
        out += '  h                toggle this help\n';
        out += '  q / ESC          cancel WITHOUT answering (back to the list)\n';
        out += '  Ctrl+C           quit ocmux\n';
        out += '\nPress any key to return.\n';
        process.stderr.write(out);
        return;
      }
      const form = answer.forms[answer.index];
      const items = answerItems();
      clampAnswerCursor();
      const cols = process.stdout.columns || 80;
      const termRows = process.stdout.rows || 24;
      // Title bar + form line + status bar eat 3 rows.
      const viewHeight = Math.max(1, termRows - 3);
      const win = windowFor(items.length, answer.cursor, viewHeight);
      const title = `ocmux — answer: ${answer.title}`.slice(0, cols);
      out += BAR_BG + centerIn(title, cols) + '\x1b[0m\n';
      const formLine = (answer.forms.length > 1 ? `Form ${answer.index + 1}/${answer.forms.length} · ` : '')
        + (form && form.title ? form.title : '');
      out += formLine ? `${BROWN}${formLine.slice(0, cols)}\x1b[0m\n` : '\n';
      for (let i = win.start; i < win.start + win.count && i < items.length; i++) {
        const item = items[i];
        const clickable = isAnswerClickable(item);
        const ptr = (clickable && i === answer.cursor) ? `${LIGHT_YELLOW}▶\x1b[0m ` : '  ';
        out += ptr + renderAnswerItem(item, cols) + '\n';
      }
      for (let i = win.start + win.count; i < viewHeight; i++) out += '\n';
      if (mode === 'input' && input) {
        out += QUESTION_BG + padLeft(`${input.prompt} ${renderInputValue(input.value)}`, cols) + '\x1b[0m\n';
        return;
      }
      let footer;
      if (answer.busy) footer = 'Submitting answers…';
      else if (answer.error) footer = `✖ ${answer.error}`;
      else footer = 'Space/Enter: select · h: help · q: cancel · Ctrl+C: quit';
      out += BAR_BG + (footer.length > cols ? footer.slice(0, cols) : padLeft(footer, cols)) + '\x1b[0m\n';
      process.stderr.write(out);
    };

    // ── Permission-answer screen ('P') ────────────────────────────────
    // Each pending permission request of the cursor session is answered in
    // turn: o/1 allow once, a allow always, r reject. drawPerm renders the
    // request summary; the decision keys post the reply and advance.
    const drawPerm = () => {
      let out = '\x1b[2J\x1b[H';
      if (mode === 'perm-help') {
        out += 'ocmux — permission help\n\n';
        out += '  o / 1            allow this request ONCE\n';
        out += '  a                allow ALWAYS (remembered for the session)\n';
        out += '  r                REJECT\n';
        out += '  h                toggle this help\n';
        out += '  q / ESC          back to the session list (leave it pending)\n';
        out += '  Ctrl+C           quit ocmux\n';
        out += '\nPress any key to return.\n';
        process.stderr.write(out);
        return;
      }
      const cols = process.stdout.columns || 80;
      const termRows = process.stdout.rows || 24;
      const req = perm.list[perm.cursor];
      out += BAR_BG + centerIn(`ocmux — permission: ${perm.title}`, cols) + '\x1b[0m\n';
      const countLine = perm.list.length > 1 ? `Request ${perm.cursor + 1}/${perm.list.length}` : '';
      out += (countLine ? `${BROWN}${countLine.slice(0, cols)}\x1b[0m\n` : '\n');
      if (req) {
        out += `  Action: ${String(req.action || 'unknown').slice(0, cols - 9)}\n`;
        const res = (req.resources || []).join(', ') || '(none)';
        out += `  Resources: ${res.slice(0, cols - 12)}\n`;
        if (req.message) out += `  Message: ${String(req.message).slice(0, cols - 10)}\n`;
        if (req.save && req.save.length) out += `  Remember: ${req.save.join(', ').slice(0, cols - 11)}\n`;
      }
      const bodyCount = req ? 2 + (req.message ? 1 : 0) + (req.save && req.save.length ? 1 : 0) : 0;
      for (let i = 2 + bodyCount; i < termRows - 1; i++) out += '\n';
      let footer;
      if (perm.busy) footer = 'Replying…';
      else if (perm.error) footer = `✖ ${perm.error}`;
      else footer = 'o: allow once · a: allow always · r: reject · h: help · q: back · Ctrl+C: quit';
      out += BAR_BG + (footer.length > cols ? footer.slice(0, cols) : padLeft(footer, cols)) + '\x1b[0m\n';
      process.stderr.write(out);
    };

    // Open permission mode for the cursor session: fetch the location's pending
    // permission requests and keep only this session's (the poll only tracks
    // ids, not the full request objects).
    const startPerm = (target) => {
      listPendingPermissions(server, dir).then((all) => {
        const list = (all || []).filter((r) => String(r.sessionID) === String(target.id));
        if (!list.length) { notices.push('No pending permission to answer.'); draw(); return; }
        perm = {
          list,
          cursor: 0,
          error: null,
          busy: false,
          title: (target.title && target.title.trim()) || target.id || 'session',
        };
        mode = 'perm';
        draw();
      }).catch(commandErr);
    };

    // Post a decision for the current permission request; on success drop it
    // from the list and advance to the next (or return to the session list
    // once all are answered).
    const submitPerm = (decision) => {
      if (perm.busy) return;
      const req = perm.list[perm.cursor];
      if (!req) return;
      perm.busy = true;
      perm.error = null;
      draw();
      replyToPermission(server, req.sessionID, req.id, decision).then(() => {
        perm.busy = false;
        perm.list.splice(perm.cursor, 1);
        if (perm.list.length === 0) {
          perm = null;
          mode = 'normal';
          notices.push('✔ Permission answered.');
          return refreshPending();
        }
        perm.cursor = Math.min(perm.cursor, perm.list.length - 1);
        perm.error = null;
        draw();
        return refreshPending();
      }).catch((err) => {
        perm.busy = false;
        perm.error = (err && err.message) || 'Failed to reply.';
        draw();
      });
    };

    const applyDelete = () => {
      const s = confirmDel;
      if (!s || !onDelete) return;
      const wasBroadcast = mode === 'broadcast-confirm';
      const deletingAll = confirmAll;
      // 'D' removes every session in the broadcast selection; 'd' removes just
      // the cursor row.
      const targets = deletingAll
        ? rows.filter(r => broadcastSel.has(String(r.id)))
        : [s];
      confirmDel = null;
      confirmAll = false;
      Promise.resolve(Promise.all(targets.map(t => onDelete(t)))).then(() => {
        const removed = new Set(targets.map(t => String(t.id)));
        rows = rows.filter(r => !removed.has(String(r.id)));
        applySearch();
        if (cursor >= view.length && cursor > 0) cursor = view.length - 1;
        if (deletingAll) {
          // Deleting the whole broadcast selection ends broadcast mode; adopt
          // the row now under the cursor as the new current (state + TUI +
          // highlight) so the list and the TUI agree on the new selection.
          // (applyPick clears the persisted broadcast; the explicit clear is
          // only needed when there is no row left to adopt.)
          broadcastSel = new Set();
          mode = 'normal';
          const next = view[cursor];
          if (next) applyPick(next);
          else { persistBroadcast([]); current = null; draw(); }
          return;
        }
        if (wasBroadcast) {
          broadcastSel.delete(String(s.id));
          if (broadcastSel.size < 2) {
            // Broadcast ended: make the remaining selected session the real
            // selection (switch the TUI to it and store it). applyPick clears
            // the persisted broadcast; clear it here too when no row remains.
            const remaining = [...broadcastSel][0];
            broadcastSel = new Set();
            mode = 'normal';
            const row = rows.find(r => String(r.id) === String(remaining));
            if (row) applyPick(row);
            else { persistBroadcast([]); draw(); }
          } else {
            persistBroadcast([...broadcastSel]);
            mode = 'broadcast';
            // Keep the anchor session pointing at something that still exists
            // (the cursor row when it is one of the remaining selections).
            if (String(s.id) === String(current)) {
              const next = view[cursor];
              current = (next && broadcastSel.has(String(next.id))) ? next.id : ([...broadcastSel][0] || null);
            }
            draw();
          }
        } else {
          mode = 'normal';
          if (String(s.id) === String(current)) {
            // The highlighted session was deleted: adopt the row now under the
            // cursor as the new current. applyPick records it in .ocmux.json
            // and refreshes the TUI, so the list highlight and the display
            // agree on the new selection.
            const next = view[cursor];
            if (next) applyPick(next);
            else { current = null; draw(); }
          } else {
            draw();
          }
        }
      }).catch((err) => {
        process.stderr.write(`\nError: ${err.message}\n`);
        confirmDel = null;
        confirmAll = false;
        mode = wasBroadcast ? 'broadcast' : 'normal';
        draw();
      });
    };

    const persistBroadcast = (ids) => {
  if (onBroadcastChange) onBroadcastChange(ids);
};
    // Recompute the filtered session view after `rows` or the pattern change.
    const applySearch = () => {
      view = filterByPattern(rows, search.active ? search.value : '',
        (r) => `${r.title || ''} ${r.id || ''}`);
      if (cursor >= view.length) cursor = Math.max(0, view.length - 1);
    };
    // Recompute the filtered view of the currently open inline list.
    const applyListSearch = () => {
      if (!list) return;
      list.view = filterByPattern(list.items, listSearch.active ? listSearch.value : '', list.format);
      if (listCursor >= list.view.length) listCursor = Math.max(0, list.view.length - 1);
    };
    // After a broadcast attempt (cancel / drop below two): put the menu — and
    // the TUI — back on the stored current session, which inspection may have
    // relaunched away without updating `.ocmux.json`.
    const restoreCurrent = () => {
      const idx = view.findIndex((r) => String(r.id) === String(current));
      if (idx >= 0) cursor = idx;
      if (inspected && current != null && onInspectSession) onInspectSession(current);
      inspected = false;
    };
    const startBroadcast = (idx) => {
  broadcastSel = new Set([String(current), String(view[idx].id)]);
  persistBroadcast([...broadcastSel]);
  mode = 'broadcast';
  if (onInspectSession) { onInspectSession(view[idx].id); inspected = true; }
  draw();
};
const toggleBroadcast = (idx) => {
  const id = String(view[idx].id);
  const adding = !broadcastSel.has(id);
  if (adding) broadcastSel.add(id);
  else broadcastSel.delete(id);
  if (adding && onInspectSession) { onInspectSession(id); inspected = true; }
  if (broadcastSel.size < 2) {
    // Deselecting down to one session ends broadcast mode by making that
    // remaining session the actual selection. applyPick clears the persisted
    // broadcast; clear it here too when no row remains.
    const remaining = [...broadcastSel][0];
    broadcastSel = new Set();
    mode = 'normal';
    const row = rows.find(r => String(r.id) === String(remaining));
    if (row) applyPick(row);
    else { persistBroadcast([]); restoreCurrent(); draw(); }
    return;
  }
  persistBroadcast([...broadcastSel]);
  draw();
};

    // `startCursor` lets a picker open with the cursor already on the relevant
    // entry (the model pickers open on the current model).
    const openList = (title, items, format, onEnter, returnMode = 'normal', startCursor = 0) => {
      if (!items || items.length === 0) {
        process.stderr.write(`\nNo ${title.toLowerCase()} available.\n`);
        draw();
        return;
      }
      list = { title, items, view: items, format, onEnter, returnMode };
      listSearch = newSearchState();
      listCursor = Math.max(0, Math.min(startCursor, items.length - 1));
      mode = 'list';
      draw();
    };

    const commandErr = (err) => {
      process.stderr.write(`\nError: ${err.message}\n`);
      draw();
    };

    // Open the model picker with the list sorted by provider and the cursor
    // already on `session`'s current model (so `m` starts where the change is).
    const openModelPicker = (title, session, returnMode, onPick) => {
      listModels(server).then((models) => {
        const sorted = sortModels(models);
        openList(title, sorted, (x) => `${x.label}${x.variant ? `#${x.variant}` : ''}`,
          onPick, returnMode, indexOfModel(sorted, session && session.model));
      }).catch(commandErr);
    };

    process.stdin.on('keypress', (str, key) => {
      // Ctrl+C always fully exits ocmux, from any menu.
      if (key.ctrl && key.name === 'c') {
        if (mode === 'broadcast' || mode === 'broadcast-confirm') {
          persistBroadcast([]);
          broadcastSel = new Set();
          restoreCurrent();
        }
        return finish(null);
      }
      if (mode === 'help' || mode === 'broadcast-help' || mode === 'list-help' || mode === 'answer-help' || mode === 'perm-help') {
        mode = mode === 'broadcast-help' ? 'broadcast'
          : (mode === 'list-help' ? 'list'
            : (mode === 'answer-help' ? 'answer'
              : (mode === 'perm-help' ? 'perm' : 'normal')));
        draw();
        return;
      }
      if (mode === 'confirm' || mode === 'broadcast-confirm') {
        if (key.name === 'y') return applyDelete();
        if (key.name === 'n' || key.name === 'escape' || key.name === 'q' || key.name === 'return') {
          confirmDel = null;
          confirmAll = false;
          mode = mode === 'broadcast-confirm' ? 'broadcast' : 'normal';
          draw();
        }
        return;
      }
      if (mode === 'input') {
        if (key.name === 'escape') {
          const wasAnswer = input && input.kind === 'answer';
          input = null;
          mode = wasAnswer ? 'answer' : 'normal';
          draw();
        } else if (key.name === 'return' || key.name === 'enter') {
          const v = input.value;
          const kind = input.kind;
          const targetKey = input.targetKey;
          input = null;
          mode = kind === 'answer' ? 'answer' : 'normal';
          draw();
          if (kind === 'create') {
            applyPick({ new: true, name: v.trim() });
          } else if (kind === 'reminder') {
            applyReminder(v.trim());
          } else if (kind === 'answer') {
            applyAnswerValue(targetKey, v);
            draw();
          } else if (v.trim()) {
            applyRenameWith(v.trim());
          }
        } else if (key.name === 'backspace') {
          if (input.caret > 0) {
            input.value = input.value.slice(0, input.caret - 1) + input.value.slice(input.caret);
            input.caret--;
          }
          draw();
        } else if (key.name === 'delete' || key.name === 'del') {
          if (input.caret < input.value.length) {
            input.value = input.value.slice(0, input.caret) + input.value.slice(input.caret + 1);
          }
          draw();
        } else if (key.name === 'left' || str === '\u001b[D') {
          input.caret = Math.max(0, input.caret - 1);
          draw();
        } else if (key.name === 'right' || str === '\u001b[C') {
          input.caret = Math.min(input.value.length, input.caret + 1);
          draw();
        } else if (key.name === 'home') {
          input.caret = 0;
          draw();
        } else if (key.name === 'end') {
          input.caret = input.value.length;
          draw();
        } else if (str && !key.ctrl && !key.meta && str >= ' ') {
          input.value = input.value.slice(0, input.caret) + str + input.value.slice(input.caret);
          input.caret++;
          draw();
        }
        return;
      }
      if (mode === 'list') {
        const lr = handleSearch(str, key, listSearch);
        if (lr !== 'pass') { applyListSearch(); draw(); return; }
        if (key.name === 'escape' || key.name === 'q' || key.name === 'backspace') {
          const returnMode = list.returnMode;
          list = null;
          mode = returnMode;
          draw();
        } else if (key.name === 'h') {
          mode = 'list-help';
          draw();
        } else if (key.name === 'up' || str === 'k') {
          if (list.view.length) listCursor = (listCursor - 1 + list.view.length) % list.view.length;
          draw();
        } else if (key.name === 'down' || str === 'j') {
          if (list.view.length) listCursor = (listCursor + 1) % list.view.length;
          draw();
        } else if (key.name === 'return' || key.name === 'enter' || key.name === 'space') {
          const item = list.view[listCursor];
          if (item === undefined) { draw(); return; }
          const onEnter = list.onEnter;
          const returnMode = list.returnMode;
          list = null;
          mode = returnMode;
          draw();
          Promise.resolve(onEnter(item)).then(() => draw()).catch(commandErr);
        }
        return;
      }
      const sr = handleSearch(str, key, search);
      if (sr !== 'pass') { applySearch(); draw(); return; }
      if (mode === 'answer' && answer) {
        if (answer.busy) return;
        if (key.name === 'escape' || key.name === 'q') {
          // Cancel WITHOUT answering — back to the session list.
          answer = null;
          mode = 'normal';
          draw();
        } else if (key.name === 'h') {
          mode = 'answer-help';
          draw();
        } else if (key.name === 'up' || str === 'k') {
          moveAnswerCursor(-1);
        } else if (key.name === 'down' || str === 'j') {
          moveAnswerCursor(1);
        } else if (key.name === 'return' || key.name === 'enter' || key.name === 'space') {
          const items = answerItems();
          const item = items[answer.cursor];
          if (item && item.kind === 'submit') submitAnswer();
          else if (item && item.kind === 'option') activateOption(item);
        }
        return;
      }
      if (mode === 'perm' && perm) {
        if (perm.busy) return;
        if (key.name === 'escape' || key.name === 'q') {
          // Back to the session list, leaving the request(s) pending.
          perm = null;
          mode = 'normal';
          draw();
        } else if (key.name === 'h') {
          mode = 'perm-help';
          draw();
        } else if (str === 'o' || str === '1') {
          submitPerm('once');
        } else if (str === 'a') {
          submitPerm('always');
        } else if (str === 'r') {
          submitPerm('reject');
        }
        return;
      }
      if (mode === 'broadcast') {
        if (key.name === 'escape') {
          persistBroadcast([]);
          broadcastSel = new Set();
          mode = 'normal';
          restoreCurrent();
          draw();
        } else if (key.name === 'q') {
          // 'q' only quits from the plain session list; in broadcast mode it
          // cancels back to that list (Ctrl+C quits from anywhere).
          persistBroadcast([]);
          broadcastSel = new Set();
          mode = 'normal';
          restoreCurrent();
          draw();
        } else if (key.name === 'h') {
          mode = 'broadcast-help';
          draw();
        } else if (key.name === 'space') {
          if (cursor < view.length) toggleBroadcast(cursor);
        } else if (str === 'D') {
          // Shift+d: delete ALL broadcast-selected sessions at once (with
          // confirmation), handy to drop a whole selection you no longer want.
          if (broadcastSel.size > 0) {
            confirmAll = true;
            confirmDel = { all: true };
            mode = 'broadcast-confirm';
            draw();
          }
        } else if (key.name === 'd') {
          if (cursor < view.length) {
            confirmDel = view[cursor];
            mode = 'broadcast-confirm';
            draw();
          }
        } else if (key.name === 'm') {
          openModelPicker('Broadcast model (all selected sessions)', view[cursor], 'broadcast', async (item) => {
            await Promise.all([...broadcastSel].map(id => switchModel(server, id, item)));
          });
        } else if (key.name === 'return' || key.name === 'enter') {
          if (cursor < view.length) {
            // Enter ends broadcast mode: applyPick clears the persisted
            // selection so agentp stops broadcasting to these sessions.
            mode = 'normal';
            applyPick(view[cursor]);
          }
        } else if (view.length > 0 && (key.name === 'up' || str === 'k')) {
          cursor = (cursor - 1 + view.length) % view.length;
          draw();
        } else if (view.length > 0 && (key.name === 'down' || str === 'j')) {
          cursor = (cursor + 1) % view.length;
          draw();
        }
        return;
      }
      if (key.name === 'q') return finish(null);
      // 'P' (Shift+p) answers the cursor session's pending permission request(s).
      // Checked before the 'p' project-switcher below for the same readline
      // reason as 'A'/'a': Shift+P arrives as name 'p' with the shift flag.
      if (str === 'P' || (key.name === 'p' && key.shift)) {
        const target = view[cursor];
        if (target && pendingPerms.has(String(target.id))) startPerm(target);
        return;
      }
      if (key.name === 'p') return finish('switch-project');
      if (key.name === 'h') {
        mode = 'help';
        draw();
        return;
      }
      if (key.name === 'n') {
        startInput('New session name (blank = auto):', 'Enter: create · Esc: cancel', '', 'create');
        return;
      }
      // Shift+r → Reminder; lowercase r → Rename.
      if (str === 'R') {
        const row = view[cursor];
        const note = (row && annotations && annotations[row.id]) || '';
        startInput('Reminder (blank clears):', 'Enter: save · Esc: cancel', note, 'reminder');
        return;
      }
      if (key.name === 'r' && cursor < view.length) {
        startInput('Rename to:', 'Enter: rename · Esc: cancel', view[cursor].title || '', 'rename');
        return;
      }
      // 'A' (Shift+a) answers pending agent questions. It MUST be checked
      // before the 'a' agent handler below: readline reports Shift+A as
      // name 'a' with the shift flag (str 'A'), so the lowercase branch would
      // otherwise swallow it and open the agent switcher instead.
      if (str === 'A' || (key.name === 'a' && key.shift)) {
        // Answer-mode: only when the cursor session actually has a pending
        // agent question (a pending form) — 'P' answers permissions instead.
        const target = view[cursor];
        if (target && pendingForms.has(String(target.id))) startAnswer(target);
        return;
      }
      if (key.name === 'a') {
        const target = view[cursor];
        if (target) {
          listAgents(server).then((all) => {
            const primary = all.filter(x => x.mode === 'primary' && !x.hidden);
            const agents = primary.length ? primary : all;
            openList('Agents', agents, (x) => `${x.name || x.id}${x.description ? ' — ' + x.description.slice(0, 40) : ''}`, (item) =>
              updateSession(server, target.id, null, item.id));
          }).catch(commandErr);
        }
        return;
      }
      if (key.name === 'm') {
        const target = view[cursor];
        if (target) openModelPicker('Models', target, 'normal', (item) => switchModel(server, target.id, item));
        return;
      }
      if (key.name === 'd') {
        if (cursor < view.length) {
          confirmDel = view[cursor];
          mode = 'confirm';
          draw();
        }
        return;
      }
      if (view.length > 0 && (key.name === 'up' || str === 'k')) {
        cursor = (cursor - 1 + view.length) % view.length;
        draw();
      } else if (view.length > 0 && (key.name === 'down' || str === 'j')) {
        cursor = (cursor + 1) % view.length;
        draw();
      } else if (key.name === 'return' || key.name === 'enter') {
        if (cursor < view.length) applyPick(view[cursor]);
      } else if (key.name === 'space') {
        // Start broadcast only when adding a DIFFERENT session to the current one.
        if (cursor < view.length && String(view[cursor].id) !== String(current)) {
          startBroadcast(cursor);
        } else if (cursor < view.length) {
          draw(); // no-op on the already-selected session
        }
      }
    });

    readline.emitKeypressEvents(process.stdin);
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdout.on('resize', draw);
    // Animate the spinner while any listed session is running.
    if (rows.some(s => runningIds && runningIds.has(s.id))) {
      spinTimer = setInterval(() => { spinIdx++; draw(); }, 120);
    }
    // Poll for pending agent questions / permission replies while the picker is
    // open (the ❓/🔒 marker columns and the 'A' entry refresh live).
    if (loadPending) {
      refreshPending();
      pendingTimer = setInterval(() => { refreshPending(); }, PENDING_POLL_MS);
    }
    process.stderr.write('\x1b[?1049h\x1b[?25l');
    draw();
  });
}

// Interactive project picker — never writes state (it only moves what a
// registered dedicated/shared TUI displays).
//
// Default (safe): an INSPECTOR. Selecting a project/session row still focuses
// the routed TUI and shows the session there, but the promise always resolves to
// null, so the caller re-opens its own project's list. Nothing about the
// caller's project changes.
//
// `{ allProjects: true }` (CLI `--all-projects`): a real SWITCHER. Selecting a
// row also records the target directory, so the caller moves its picker there
// and can then write that project's `.ocmux.json` — the file `agentp` reads in
// that directory.
function switchMenu(rows, { allProjects = false, onOpen, pending } = {}) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) {
      console.error('Error: "switch" is interactive and requires a TTY.');
      process.exit(1);
    }
    if (rows.length === 0) {
      console.log('No opencode projects running.');
      resolve(null);
      return;
    }

    const pendingOf = (dir) => (pending && pending.get(dir)) || { forms: new Set(), perms: new Set() };

    const nameW = Math.max(...rows.map(r => path.basename(r.dir).length), 4);
    const stsW = Math.max(...rows.map(r => r.status.length), 6);
    const ssnW = Math.max(...rows.map(r => (r.session || '').length), 7);
    const pad = (s, w) => s + ' '.repeat(Math.max(0, w - s.length));
    const cols = process.stderr.columns || 80;
    const lineWidth = Math.max(cols, nameW + 2 + stsW + 2 + ssnW + 6);

    let cursor = 0;
    let lastDir = null;       // target dir to move to (only with allProjects)
    let done = false;
    let help = false;
    const search = newSearchState();
    let view = [];              // flattened nodes: { kind:'project'|'session', ... }
    // Fold state per project directory: { open, sessions, loading, error }.
    const folds = new Map();

    const foldOf = (p) => folds.get(p.dir) || { open: false, sessions: null, loading: false, error: null };
    const projectText = (p) => `${path.basename(p.dir)} ${p.dir} ${p.session || ''}`;
    const sessionText = (s) => `${s.title || ''} ${s.id || ''}`;
    const matches = (pattern, text) => filterByPattern([1], pattern, () => text).length > 0;

    // Flatten projects (plus their unfolded sessions) honouring the '/' pattern.
    // A project header survives when it matches itself OR when one of its
    // unfolded sessions does, so a match deeper down is still navigable.
    const buildView = () => {
      const pattern = search.active ? search.value : '';
      const out = [];
      for (const p of rows) {
        const f = foldOf(p);
        const sessions = f.open && f.sessions ? f.sessions : [];
        const shown = sessions.filter((s) => matches(pattern, sessionText(s)));
        const header = { kind: 'project', project: p };
        if (sessions.length === 0) {
          if (matches(pattern, projectText(p))) out.push(header);
        } else if (matches(pattern, projectText(p)) || shown.length) {
          out.push(header);
          for (const s of shown) out.push({ kind: 'session', project: p, session: s });
        }
      }
      return out;
    };

    const sameNode = (a, b) => {
      if (!a || !b || a.kind !== b.kind || a.project.dir !== b.project.dir) return false;
      return a.kind !== 'session' || a.session.id === b.session.id;
    };

    const applySearch = () => {
      const prev = view[cursor];
      view = buildView();
      const idx = prev ? view.findIndex((n) => sameNode(n, prev)) : -1;
      if (idx >= 0) cursor = idx;
      else if (cursor >= view.length) cursor = Math.max(0, view.length - 1);
    };
    applySearch();

    const cleanup = () => {
      process.stderr.write('\x1b[?25h');
      process.stderr.write('\x1b[?1049l');
      process.stdout.removeListener('resize', draw);
      try { process.stdin.setRawMode(false); } catch {}
    };

    const finish = (value) => {
      if (done) return;
      done = true;
      cleanup();
      process.stdin.pause();
      process.stdin.removeAllListeners('keypress');
      process.removeListener('SIGINT', onSig);
      resolve(value === undefined ? lastDir : value);
    };

    // Mode-dependent wording: the switcher inspects by default and really
    // switches only under --all-projects.
    const switcherTitle = allProjects ? 'ocmux — project switcher (all projects)' : 'ocmux — project switcher';
    const enterHint = allProjects ? 'Enter: switch' : 'Enter: view';
    const modeNote = allProjects
      ? ['--all-projects: selecting moves the picker to that project, so a',
         'session picked there updates ITS .ocmux.json — the file agentp',
         'reads when it runs in that directory.']
      : ['Selecting only moves the TUI view — .ocmux.json is never',
         'written, so agentp keeps prompting your own project’s session.',
         'You always come back to your own project’s list.'];

    const draw = () => {
      if (done) return;
      if (help) {
        let out = '\x1b[2J\x1b[H';
        out += 'ocmux project switcher — help\n\n';
        out += '  j / k, arrows    move the cursor (projects and sessions)\n';
        out += `  Enter            ${allProjects ? 'switch the picker to the selected project' : 'focus the selected project (menu stays open)'}\n`;
        out += '                   (on a session, show it in that project’s TUI)\n';
        out += '  Space            fold/unfold a project’s sessions;\n';
        out += '                   on a session, show it in the TUI as well\n';
        out += '  /                search/filter the list (Enter keeps, ESC clears)\n';
        out += '  h                toggle this help\n';
        out += '  q                return to the session menu\n';
        out += '  Ctrl+C           quit ocmux\n';
        out += '  \n';
        out += '  Markers: ❓ pending question · 🔒 pending permission, always two\n';
        out += '           columns (the slot is reserved when absent); 🔔 in the\n';
        out += '           status bar when any listed session waits\n';
        out += '\n';
        for (const l of modeNote) out += `${l}\n`;
        out += '\nPress any key to return.\n';
        process.stderr.write(out);
        return;
      }
      const extras = [];
      if (search.active && view.length === 0) extras.push(`No projects match "${search.value}"`);
      for (const n of view) {
        if (n.kind !== 'project') continue;
        const f = folds.get(n.project.dir);
        if (!f || !f.open) continue;
        const name = path.basename(n.project.dir);
        if (f.loading) extras.push(`  … loading sessions of ${name} …`);
        else if (f.error) extras.push(`  ! ${name}: ${f.error}`);
      }
      process.stderr.write(renderList({
        title: switcherTitle,
        items: view,
        cursor,
        row: (i, node) => {
          if (node.kind === 'session') {
            const s = node.session;
            const id = String(s.id || '');
            const mark = String(s.id) === String(node.project.session) ? '  *' : '';
            const title = (s.title || id).slice(0, Math.max(8, nameW + 6));
            // Pending marker columns for this session (❓/🔒), always 4 cols.
            const pe = pendingOf(node.project.dir);
            const gr = pendingCells(pe.forms.has(id), pe.perms.has(id));
            return `  ${title}${mark} ${gr} ${id}`;
          }
          const p = node.project;
          const fold = foldOf(p).open ? '▾' : '▸';
          const session = p.session ? p.session.slice(0, 14) : '(none)';
          // A folded project shows its aggregate marker columns when ANY of its
          // sessions (per the location-scoped pending fetch) awaits an answer.
          const pe = pendingOf(p.dir);
          const gr = pendingCells(pe.forms.size > 0, pe.perms.size > 0);
          const text = `${fold} ${gr} ${pad(path.basename(p.dir), nameW)}  ${pad(p.status, stsW)}  ${pad(session, ssnW)}  ${p.dir}`;
          return text;
        },
        footer: searchFooter(search, `${enterHint} · Space: fold · /: search · h: help · q: back · Ctrl+C: quit`),
        footerLeft: search.active,
        footerRight: search.active ? SEARCH_HINT : null,
        extraLines: extras,
      }));
    };

    // Enter on a project row: show its current session in its routed TUI. With
    // allProjects off this stays a pure inspection and
    // `lastDir` is left null so the caller returns to its own project.
    const activate = (p) => {
      if (!p) return;
      try {
        if (p.server && p.session && onOpen) onOpen(p, p.session);
        if (allProjects) lastDir = p.dir;
      } catch (err) {
        process.stderr.write(`\nError: ${err.message}\n`);
      }
      draw();
    };

    // Enter/Space on a session row: move the TUI VIEW onto it. The switcher
    // itself never writes `.ocmux.json`; with allProjects on the caller only
    // moves its picker to that project — the write happens later, when a
    // session is picked there (and that file is what agentp reads there).
    const openSession = (node) => {
      const p = node.project;
      try {
        if (p.server && onOpen) onOpen(p, node.session.id);
        if (allProjects) lastDir = p.dir;
      } catch (err) {
        process.stderr.write(`\nError: ${err.message}\n`);
      }
      draw();
    };

    // Space on a project row: fetch its sessions once, then flip the fold.
    const toggleFold = (p) => {
      const f = folds.get(p.dir) || { open: false, sessions: null, loading: false, error: null };
      folds.set(p.dir, f);
      if (!f.open && !f.sessions && !f.error && !f.loading) {
        if (!p.server) {
          f.error = 'no server recorded';
        } else {
          f.loading = true;
          f.open = true;
          applySearch();
          draw();
          listSessions(p.server, p.dir)
            .then((list) => {
              // Main sessions only: child/subagent sessions are work products,
              // not navigation targets (same rule as the session picker).
              f.sessions = sortSessionsByRecency((list || []).filter((s) => !s.parentID));
            })
            .catch((err) => { f.error = err.message; })
            .then(() => { f.loading = false; applySearch(); draw(); });
          return;
        }
      }
      f.open = !f.open;
      applySearch();
      draw();
    };

    const onSig = () => finish(SWITCH_QUIT);
    process.on('SIGINT', onSig);

    process.stdin.on('keypress', (str, key) => {
      // Ctrl+C fully exits ocmux; 'q' only closes this menu (back to sessions).
      if (key.ctrl && key.name === 'c') return finish(SWITCH_QUIT);
      if (help) { help = false; draw(); return; }
      const sr = handleSearch(str, key, search);
      if (sr !== 'pass') { applySearch(); draw(); return; }
      if (key.name === 'h') { help = true; draw(); return; }
      if (key.name === 'q') return finish();
      if (view.length === 0) return;
      const node = view[cursor];
      if (key.name === 'up' || str === 'k') {
        cursor = (cursor + view.length - 1) % view.length;
        draw();
      } else if (key.name === 'down' || str === 'j') {
        cursor = (cursor + 1) % view.length;
        draw();
      } else if (key.name === 'return' || key.name === 'enter') {
        if (node.kind === 'project') activate(node.project);
        else openSession(node);
      } else if (key.name === 'space') {
        if (node.kind === 'project') toggleFold(node.project);
        else openSession(node);
      }
    });

    readline.emitKeypressEvents(process.stdin);
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdout.on('resize', draw);
    process.stderr.write('\x1b[?1049h\x1b[?25l');
    draw();
  });
}

// ---------------------------------------------------------------------------
// Subcommand: default — interactive session switcher for the current project
// ---------------------------------------------------------------------------

// `allProjects` (CLI `--all-projects`) unlocks cross-project switching: the
// project switcher may then move this picker onto another project, whose
// `.ocmux.json` gets written when a session is picked there. Without it the
// switcher is inspection-only and this command always stays on `targetDir`'s
// project.
async function cmdSessionSwitch(targetDir, directRef, allProjects = false) {
  let target = targetDir;
  for (;;) {
    const sf = findParentStatefile(target);
    if (!sf) {
      console.error(`Error: no .ocmux.json found in ${target} or any of its parents.`);
    console.error(`Run 'ocmux serve' to initialize the project.`);
      process.exit(1);
    }
    const state = projectState.readProjectState(sf);
    let server = state.server;
    if (!server) {
      console.error(`Error: ${sf} does not record a server.`);
      console.error(`Run 'ocmux serve --server <url>' to set it up, or add "server" to the file.`);
      process.exit(1);
    }
    const dir = state.directory;

    // If the recorded server is down, offer to repoint the project to the
    // default server — but only after confirming the default actually answers.
    let alive = await checkServer(server);
    if (!alive && process.stdin.isTTY && server !== DEFAULT_SERVER
      && await checkServer(DEFAULT_SERVER)) {
      const useDefault = await askYesNo(
        `OpenCode server not reachable at ${server}. Use the default ${DEFAULT_SERVER} instead? [y/N] `);
      if (useDefault) {
        projectState.writeProjectState(sf, { server: DEFAULT_SERVER });
        server = DEFAULT_SERVER;
        alive = true;
      }
    }
    if (!alive) {
      console.error(`Error: OpenCode server not reachable at ${server}.`);
      console.error(`Start it with 'opencode serve' (or your usual launcher) first.`);
      process.exit(1);
    }

    const sessions = await listSessions(server, dir).catch((err) => {
      console.error(`Error connecting to ${server}: ${err.message}`);
      process.exit(1);
    });
    const sorted = sortSessionsByRecency(sessions);
    const notices = [];
    if (state.session && !sorted.some(s => String(s.id) === String(state.session))) {
      try {
        const moved = await getSession(server, state.session);
        const movedDir = moved && moved.location && moved.location.directory;
        if (movedDir && path.resolve(movedDir) !== path.resolve(dir)) {
          notices.push(`⚠ Current session moved to ${movedDir}`);
          notices.push(`  Run: ocmux serve ${JSON.stringify(movedDir)} --server ${JSON.stringify(server)}`);
        }
      } catch {
        // A deleted/stale stored session is handled by the normal picker.
      }
    }
    // Only "main" sessions are listed in the picker: exclude child/subagent
    // sessions (parentID set) — they are work products of a main session, not
    // targets. Explicit --session can still reach one by id/title.
    const mainSessions = sorted.filter(s => !s.parentID);
    const annotations = projectState.readAnnotations(sf);
    const runningIds = await getActiveSessions(server);
    let modelContext = new Map();
    try {
      const models = await listModels(server);
      modelContext = new Map(models.filter(m => m.context).map(m => [`${m.providerID}/${m.id}`, m.context]));
    } catch { /* context limits unavailable */ }

    const applySession = (id) => {
      // A session switch also drops any persisted broadcast list, so agentp
      // never keeps broadcasting to sessions that are no longer selected.
      projectState.writeProjectState(sf, { session: id, broadcast: [] });
      refreshTui(dir, server, id);
    };

    if (directRef) {
      const pick = sorted.find(s => String(s.id) === directRef)
        || sorted.find(s => (s.title || '').toLowerCase() === directRef.toLowerCase())
        || null;
      if (!pick) {
        console.error(`Error: no session matching "${directRef}" in ${dir}.`);
        process.exit(1);
      }
      applySession(pick.id);
      return;
    }

    if (!process.stdin.isTTY) {
      // Silent path (non-TTY): project state already identifies the target.
      return;
    }

    // Interactive: Enter switches but stays open; n creates (inheriting the
    // model of the previously selected session); r renames; R sets a reminder;
    // d deletes; a switches agent; m switches model; p switches project; q quits.
    let lastRef = (state.session && mainSessions.find(s => String(s.id) === String(state.session))) || mainSessions[0] || null;
    // Opening the picker in a project routes its applicable TUI to the stored
    // session, so merely running `ocmux` here switches the pane. (Respawn is
    // skipped when the TUI is already showing that project/session.)
    if (state.session && mainSessions.some(s => String(s.id) === String(state.session))) {
      refreshTui(dir, server, state.session);
    }
    const result = await new Promise((resolve) => {
      sessionMenu(mainSessions, state.session, annotations, server, {
        dir,
        runningIds,
        modelContext,
        notices,
        // A persisted broadcast list, so the picker opens in broadcast mode when
        // one is active (validated and cleaned inside `sessionMenu`).
        broadcast: state.broadcast,
        // Pending agent questions / permission replies for this project, polled
        // by the picker while it is open. Failures degrade to empty sets.
        loadPending: () => Promise.all([
          listPendingForms(server, dir).catch(() => []),
          listPendingPermissions(server, dir).catch(() => []),
        ]).then(([forms, perms]) => ({
          forms: new Set((forms || []).map(f => f.sessionID).filter(Boolean)),
          perms: new Set((perms || []).map(x => x.sessionID).filter(Boolean)),
        })),
        onBroadcastChange: (ids) => projectState.writeProjectState(sf, { broadcast: ids }),
        onInspectSession: (id) => refreshTui(dir, server, id),
        onPick: async (row) => {
          if (row.new) {
            const created = await createSessionWithModel(server, row.name || undefined, dir, [lastRef, ...sorted]).catch((err) => {
              console.error(`Error creating session: ${err.message}`);
              return null;
            });
            if (created) applySession(created.id);
            return created || null;
          }
          lastRef = row;
          applySession(row.id);
        },
        onRename: async (row, name) => {
          const updated = await updateSession(server, row.id, name).catch((err) => {
            console.error(`Error renaming session: ${err.message}`);
            throw err;
          });
          return updated;
        },
        onDelete: async (row) => {
          await deleteSession(server, row.id).catch((err) => {
            console.error(`Error deleting session: ${err.message}`);
            throw err;
          });
          if (String(row.id) === String(state.session)) {
            projectState.writeProjectState(sf, { session: null });
          }
        },
        onReminder: async (row, text) => {
          try {
            return projectState.writeAnnotation(sf, row.id, text);
          } catch (err) {
            console.error(`Error saving reminder: ${err.message}`);
            throw err;
          }
        },
      }).then(resolve);
    });

    if (result === 'switch-project') {
      // 'p' pressed: open the project switcher. Without --all-projects it only
      // inspects (picked stays null => re-run this picker for the same
      // project); with it, picking a project re-runs the picker there.
      // Ctrl+C fully exits.
      const rows = await configuredProjects(server).catch((err) => {
        console.error(`Error listing projects: ${err.message}`);
        return [];
      });
      // Fetch each listed project's pending questions/permissions once, so
      // folded project rows (and unfolded sessions) can carry the markers.
      // Errors degrade to empty sets (no markers for that project).
      const pendingByDir = new Map();
      await Promise.all(rows.map(async (p) => {
        if (!p.server) return;
        const [forms, perms] = await Promise.all([
          listPendingForms(p.server, p.dir).catch(() => []),
          listPendingPermissions(p.server, p.dir).catch(() => []),
        ]);
        pendingByDir.set(p.dir, {
          forms: new Set((forms || []).map(f => f.sessionID).filter(Boolean)),
          perms: new Set((perms || []).map(x => x.sessionID).filter(Boolean)),
        });
      }));
      const picked = await switchMenu(rows, {
        allProjects,
        pending: pendingByDir,
        onOpen: (project, id) => refreshTui(project.dir, project.server, id),
      });
      if (picked === SWITCH_QUIT) break;
      if (!picked) continue;
      target = picked;
      continue;
    }
    break;
  }
}

// ---------------------------------------------------------------------------
// Subcommand: serve — initialize project/session state (server is user-managed)
// ---------------------------------------------------------------------------

async function cmdServeNew(targetDir, serverArg, force) {
  try { targetDir = fs.realpathSync(targetDir); } catch {}

  const sf = path.join(targetDir, '.ocmux.json');
  if (fs.existsSync(sf)) {
    if (!force) {
      console.error(`Error: project state already exists in ${targetDir}.`);
      console.error(`Use 'ocmux' to switch sessions there, or 'ocmux serve --server <url> --force' to repoint it.`);
      process.exit(1);
    }
    return doForceServe(targetDir, sf, serverArg || DEFAULT_SERVER);
  }

  const parent = findParentStatefile(path.dirname(targetDir));
  if (parent) {
    const parentDir = path.dirname(parent);
    console.error(`Warning: there is already an ocmux project in ${parentDir}.`);

    const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
    rl.question('Are you sure you want to initialize a nested project here? [y/N] ', (answer) => {
      rl.close();
      if (!/^[yY]([eE][sS])?$/.test(answer.trim())) {
        console.error('Cancelled.');
        process.exit(0);
      }
      doServeNew(targetDir, serverArg).catch((err) => {
        console.error(err ? err.message : String(err));
        process.exit(1);
      });
    });
    return;
  }
  return doServeNew(targetDir, serverArg);
}

// Repoint an existing project to a (possibly new) server. A registered TUI is
// refreshed through the normal dedicated → shared routing rule.
async function doForceServe(targetDir, sf, server) {
  const alive = await checkServer(server);
  if (!alive) {
    console.error(`Error: OpenCode server not reachable at ${server}.`);
    console.error(`Start it with 'opencode serve' (or pass --server <url>).`);
    process.exit(1);
  }
  const state = projectState.readProjectState(sf);
  const sessions = await listSessions(server, targetDir).catch((err) => {
    console.error(`Error connecting to ${server}: ${err.message}`);
    process.exit(1);
  });
  let session = (state && state.session && sessions.some(s => String(s.id) === String(state.session)))
    ? state.session
    : newestSessionId(sessions);
  if (!session) {
    const created = await createSessionWithModel(server, undefined, targetDir, sessions);
    session = created.id;
  }
  projectState.writeProjectState(sf, { server, session });
  refreshTui(targetDir, server, session);
  console.error(`Repointed ${targetDir} to ${server} (session ${session}).`);
}

async function doServeNew(targetDir, serverArg) {
  const server = serverArg || DEFAULT_SERVER;

  const alive = await checkServer(server);
  if (!alive) {
    console.error(`Error: OpenCode server not reachable at ${server}.`);
    console.error(`Start it with 'opencode serve' (or --server <url> to point elsewhere).`);
    process.exit(1);
  }

  // Pick the newest session already in this directory, or create one.
  let sessions = [];
  try {
    sessions = await listSessions(server, targetDir);
  } catch (err) {
    console.error(`Error connecting to ${server}: ${err.message}`);
    process.exit(1);
  }
  let session = newestSessionId(sessions);
  if (!session) {
    try {
      const created = await createSessionWithModel(server, undefined, targetDir, sessions);
      session = created.id;
    } catch (err) {
      console.error(`Error creating session: ${err.message}`);
      process.exit(1);
    }
  }

  projectState.writeProjectState(path.join(targetDir, '.ocmux.json'), {
    directory: targetDir,
    server,
    session,
    status: 'active',
  });
  refreshTui(targetDir, server, session);
  console.error(`Initialized ${targetDir} → ${server} (session ${session}).`);
}

// ---------------------------------------------------------------------------
// Subcommand: tui — register this tmux pane and host an OpenCode TUI
// ---------------------------------------------------------------------------

async function cmdTui(targetDir, serverArg, shared, sessionArg) {
  const tmuxTarget = tuiRegistry.parseTmuxEnvironment();
  if (!tmuxTarget) {
    console.error("Error: 'ocmux tui' must run inside a tmux pane.");
    process.exit(1);
  }
  const sf = findParentStatefile(targetDir);
  const state = sf ? projectState.readProjectState(sf) : null;
  if (!state && !shared) {
    console.error(`Error: no .ocmux.json found in ${targetDir} or any of its parents.`);
    console.error("Run 'ocmux serve' first.");
    process.exit(1);
  }
  // The shared TUI is a cross-project fallback, so it can run without a project
  // state file (defaulting to the configured/default server).
  const directory = state ? state.directory : targetDir;
  const server = serverArg || (state && state.server) || DEFAULT_SERVER;
  if (!await checkServer(server)) {
    console.error(`Error: OpenCode server not reachable at ${server}.`);
    process.exit(1);
  }

  let session = sessionArg || (state && state.session) || null;
  if (session) {
    try {
      const found = await getSession(server, session);
      if (found.location && found.location.directory) targetDir = found.location.directory;
    } catch {
      session = null;
    }
  }
  if (!session) {
    const sessions = await listSessions(server, directory);
    session = newestSessionId(sessions);
    if (!session) session = (await createSessionWithModel(server, undefined, directory, sessions)).id;
    if (sf) projectState.writeProjectState(sf, { session, server });
  }

  const registration = tuiRegistry.register({
    ...tmuxTarget,
    shared,
    directory: shared ? targetDir : directory,
    server,
    session,
    pid: process.pid,
  });

  const instance = registration.instance;
  const launchDir = targetDir || directory;
  const child = child_process.spawn('opencode', tuiArgs(server, session, launchDir), {
    cwd: launchDir,
    stdio: 'inherit',
  });
  tuiRegistry.updateInstance(instance.id, instance.token, { childPid: child.pid || null });

  return new Promise((resolve, reject) => {
    let settled = false;
    const forward = (signal) => {
      try { child.kill(signal); } catch {}
    };
    const onHup = () => forward('SIGHUP');
    const onTerm = () => forward('SIGTERM');
    const onInt = () => forward('SIGINT');
    process.on('SIGHUP', onHup);
    process.on('SIGTERM', onTerm);
    process.on('SIGINT', onInt);
    const finish = (err) => {
      if (settled) return;
      settled = true;
      process.removeListener('SIGHUP', onHup);
      process.removeListener('SIGTERM', onTerm);
      process.removeListener('SIGINT', onInt);
      tuiRegistry.unregister(instance.id, instance.token);
      if (err) reject(err);
      else resolve();
    };
    child.once('error', finish);
    child.once('exit', () => finish());
  });
}

function tuiProjectDirectory(targetDir) {
  const sf = findParentStatefile(targetDir);
  if (!sf) return null;
  const state = projectState.readProjectState(sf);
  return state && state.directory;
}

function formatTuiRegistration(instance) {
  return `${instance.shared ? 'shared' : 'project'}  ${instance.pane}  ${instance.directory || '(none)'}  ${instance.server || '(none)'}  ${instance.session || '(none)'}`;
}

function cmdTuiList() {
  const instances = tuiRegistry.list();
  if (instances.length === 0) {
    console.log('No registered TUIs.');
    return;
  }
  console.log('Kind     Pane  Directory  Server  Session');
  for (const instance of instances) console.log(formatTuiRegistration(instance));
}

function cmdTuiStatus(targetDir, shared) {
  const directory = shared ? null : tuiProjectDirectory(targetDir);
  if (!shared && !directory) {
    console.error(`Error: no .ocmux.json found in ${targetDir} or any of its parents.`);
    process.exit(1);
  }
  const instance = shared ? tuiRegistry.shared() : tuiRegistry.dedicated(directory);
  if (!instance) {
    console.log(shared ? 'Shared TUI: not registered' : `Project TUI: not registered (${directory})`);
    return;
  }
  console.log(formatTuiRegistration(instance));
}

function cmdTuiDetach(targetDir, shared) {
  const directory = shared ? null : tuiProjectDirectory(targetDir);
  if (!shared && !directory) {
    console.error(`Error: no .ocmux.json found in ${targetDir} or any of its parents.`);
    process.exit(1);
  }
  const instance = shared ? tuiRegistry.shared() : tuiRegistry.dedicated(directory);
  if (!instance) {
    console.log(shared ? 'Shared TUI was not registered.' : `Project TUI was not registered (${directory}).`);
    return;
  }
  tuiRegistry.unregister(instance.id, instance.token);
  console.log(`Detached ${shared ? 'shared' : 'project'} TUI from ${instance.pane}.`);
}

// ---------------------------------------------------------------------------
// Subcommand: list
// ---------------------------------------------------------------------------

async function cmdList(longMode, server) {
  const rows = await configuredProjects(server);
  if (rows.length === 0) {
    console.log('No configured ocmux projects found.');
    return;
  }

  const dirW = Math.max(...rows.map(r => r.dir.length), 9);
  const stsW = Math.max(...rows.map(r => r.status.length), 6);
  const ssnW = Math.max(...rows.map(r => (r.session || '').length), 7);
  const pad = (s, w) => s + ' '.repeat(Math.max(0, w - s.length));

  console.log(`${pad('Directory', dirW)}  ${pad('Status', stsW)}  ${pad('Session', ssnW)}`);
  for (const row of rows) {
    console.log(`${pad(row.dir, dirW)}  ${pad(row.status, stsW)}  ${pad(row.session || '(none)', ssnW)}`);
    if (longMode && row.server) console.log(`    server: ${row.server}`);
  }
}

// ---------------------------------------------------------------------------
// Subcommand: migrate — rewrite legacy .ocmux.json files to v2
// ---------------------------------------------------------------------------

async function cmdMigrate(server) {
  const rows = await configuredProjects(server);
  let migrated = 0;
  for (const row of rows) {
    const sf = projectState.statefileFor(row.dir);
    const state = projectState.readProjectState(sf);
    if (!state) continue;
    if (state.version >= 2) continue;
    projectState.writeProjectState(sf, {
      directory: row.dir,
      server: state.server,
      session: state.session,
    });
    migrated++;
    console.error(`Migrated ${sf}`);
  }
  if (migrated === 0) console.error('No legacy state files found.');
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Help
// ---------------------------------------------------------------------------

function printHelp() {
  console.error(`Usage: ${SCRIPT} [-l] [--all-projects] [<subcommand>] [<directory>]`);
  console.error('');
  console.error('Manage project/session routing and optional registered OpenCode TUIs.');
  console.error('The OpenCode server is user-managed: start it with `opencode serve`.');
  console.error('');
  console.error('Without arguments, searches upward from <directory> (default: $PWD)');
  console.error('for .ocmux.json and opens an interactive SESSION picker for that');
  console.error('project (requires a TTY). The title bar names the project whose');
  console.error('sessions are listed. In the picker:');
  console.error('  Enter switch · n new · r rename · R remind · d delete · a agents · m model');
  console.error('  p projects · h help · q quit · A answer the selected session\'s questions');
  console.error('  P answer its pending permission requests (allow once / always / reject)');
  console.error('  In BROADCAST: Space toggles a session · d deletes cursor · D deletes all');
  console.error('List rows and the project switcher carry pending marker columns: ❓ agent');
  console.error('question, 🔒 permission request (one column each, the slot is always');
  console.error('reserved); the status bar shows 🔔 when any listed session waits.');
  console.error('The picker re-checks every 2s while open.');
  console.error('Selecting updates .ocmux.json and refreshes a dedicated TUI, falling');
  console.error('back to the shared TUI. Opening the picker also routes that project\'s');
  console.error('TUI to its stored session. Silent on success. (p opens projects; by');
  console.error('default it only inspects other projects and never modifies any');
  console.error('.ocmux.json — see --all-projects.)');
  console.error('If the recorded server is down but the default server answers, ocmux');
  console.error('offers to repoint the project to the default.');
  console.error('');
  console.error('Subcommands:');
  console.error('  serve     Initialize project state for <directory> (default: $PWD).');
  console.error('            --server <url>  Server to record (default: $OCMUX_SERVER or http://localhost:4096).');
  console.error('            --force         Repoint an existing project to --server (overwrites .ocmux.json).');
  console.error('            --git / --GIT   Use the nearest parent with a .git entry / directory.');
  console.error('            Aliased as "new" for backwards compatibility.');
  console.error('  tui [--shared] [--server <url>] [directory]');
  console.error('            Register the current tmux pane and run its OpenCode TUI.');
  console.error('            Without --shared it is dedicated to the current project;');
  console.error('            --shared makes it the single fallback for every project and');
  console.error('            runs even without .ocmux.json (using the default server).');
  console.error('            --list lists all live registrations; --status inspects one;');
  console.error('            --detach unregisters one without closing its pane or TUI.');
  console.error('            With --status/--detach, --shared targets the shared slot;');
  console.error('            otherwise the slot dedicated to directory is targeted.');
  console.error('  session <id|title>');
  console.error('            Non-interactive session switch for the current project.');
  console.error('  list [-l] List configured projects and TUI routing status.');
  console.error('  migrate   Rewrite legacy .ocmux.json files to the v2 schema.');
  console.error('');
  console.error('Reminders: the R key in the session picker attaches a note to a');
  console.error('session; agentp prepends it to every prompt sent to that session.');
  console.error('');
  console.error('Options:');
  console.error('  -l          Long output (list: also show server URL).');
  console.error('  --all-projects');
  console.error('                  Let the picker’s project switcher (p) MOVE to another');
  console.error('                  project, so picking a session there updates that');
  console.error('                  project’s .ocmux.json (what agentp reads in it).');
  console.error('                  Default: the switcher only inspects other projects');
  console.error('                  and you always return to your own project’s list.');
  console.error('  --version   Show version');
  console.error('  -h          Show this help');
  console.error('');
  console.error('See also: agentp -- pipe prompts into OpenCode from stdin');
  console.error('          tgagentp -- Telegram bridge for OpenCode (tgagentp --help)');
  process.exit(0);
}

// ---------------------------------------------------------------------------
// Argument parsing + dispatch
// ---------------------------------------------------------------------------

function main() {
  let longMode = false;
  let gitMode = null;
  let serverArg = null;
  let force = false;
  let allProjects = false;
  let sharedTui = false;
  let tuiSession = null;
  let tuiList = false;
  let tuiStatus = false;
  let tuiDetach = false;
  const positional = [];

  const parsedArgs = process.argv.slice(2);
  for (let i = 0; i < parsedArgs.length; i++) {
    const arg = parsedArgs[i];
    if (arg === '-l') {
      longMode = true;
    } else if (arg === '--server') {
      const val = parsedArgs[i + 1];
      if (!val || val.startsWith('-')) {
        console.error("Error: '--server' requires a URL argument.");
        process.exit(1);
      }
      serverArg = val;
      i++;
    } else if (arg === 'switch' || arg === 'model') {
      console.error(`Error: the '${arg}' subcommand was removed.`);
      console.error(`Press '${arg === 'switch' ? 'p' : 'm'}' inside the session picker (ocmux) for that action.`);
      process.exit(1);
    } else if (arg === '--force') {
      force = true;
    } else if (arg === '--shared') {
      sharedTui = true;
    } else if (arg === '--session-id') {
      const val = parsedArgs[i + 1];
      if (!val || val.startsWith('-')) {
        console.error("Error: '--session-id' requires a session ID.");
        process.exit(1);
      }
      tuiSession = val;
      i++;
    } else if (arg === '--list') {
      tuiList = true;
    } else if (arg === '--status') {
      tuiStatus = true;
    } else if (arg === '--detach') {
      tuiDetach = true;
    } else if (arg === '--all-projects') {
      allProjects = true;
    } else if (arg === '--git') {
      if (gitMode && gitMode !== 'nearest') {
        console.error("Error: cannot combine '--git' with '--GIT'.");
        process.exit(1);
      }
      gitMode = 'nearest';
    } else if (arg === '--GIT') {
      if (gitMode && gitMode !== 'root') {
        console.error("Error: cannot combine '--git' with '--GIT'.");
        process.exit(1);
      }
      gitMode = 'root';
    } else if (arg === '--version') {
      console.log(version);
      process.exit(0);
    } else if (arg === '-h' || arg === '--help') {
      printHelp();
    } else if (arg === '--') {
      const directory = parsedArgs[i + 1];
      if (!directory) {
        console.error("Error: '--' requires a directory argument.");
        process.exit(1);
      }
      positional.push({ value: directory, forcedDirectory: true });
      i++;
    } else if (arg.startsWith('-')) {
      console.error(`Error: unknown option '${arg}'`);
      console.error(`Run '${SCRIPT} -h' for help.`);
      process.exit(1);
    } else {
      positional.push({ value: arg, forcedDirectory: false });
    }
  }

  // Handle --server <url> (inline-consumed in the loop above; nothing here).

  let subcommand = null;
  let targetDir = null;
  let directRef = null;

  for (const positionalArg of positional) {
    const arg = positionalArg.value;
    if (positionalArg.forcedDirectory) {
      if (targetDir) {
        console.error(`Error: unexpected argument '${arg}'`);
        process.exit(1);
      }
      targetDir = resolveDir(arg);
    } else if (arg === 'serve' || arg === 'new' || arg === 'list' || arg === 'tui'
      || arg === 'session'
      || arg === 'migrate') {
      if (subcommand) {
        console.error(`Error: multiple subcommands specified: '${subcommand}' and '${arg}'`);
        process.exit(1);
      }
      subcommand = arg;
    } else if (subcommand === 'session' && directRef === null) {
      directRef = arg;
    } else {
      if (targetDir) {
        console.error(`Error: unexpected argument '${arg}'`);
        process.exit(1);
      }
      targetDir = resolveDir(arg);
    }
  }

  if (!targetDir) targetDir = process.cwd();

  if (sharedTui && subcommand !== 'tui') {
    console.error("Error: '--shared' is only valid with 'ocmux tui'.");
    process.exit(1);
  }
  if (tuiSession && subcommand !== 'tui') {
    console.error("Error: '--session-id' is only valid with 'ocmux tui'.");
    process.exit(1);
  }
  if ((tuiList || tuiStatus || tuiDetach) && subcommand !== 'tui') {
    console.error("Error: '--list', '--status', and '--detach' are only valid with 'ocmux tui'.");
    process.exit(1);
  }
  if ([tuiList, tuiStatus, tuiDetach].filter(Boolean).length > 1) {
    console.error("Error: combine at most one of '--list', '--status', and '--detach'.");
    process.exit(1);
  }

  // Dispatch. Each branch may throw synchronously (EXIT) for validation errors
  // or return a promise for async commands; main() returns the settled promise
  // so tests can await it.
  let p = Promise.resolve();

  if (subcommand === 'list') {
    if (gitMode) {
      console.error("Error: '--git' and '--GIT' are only valid with 'serve'.");
      process.exit(1);
    }
    if (targetDir !== process.cwd()) {
      console.error("Error: 'list' does not accept a directory path.");
      process.exit(1);
    }
    p = cmdList(longMode, serverArg || DEFAULT_SERVER);
  } else if (subcommand === 'tui') {
    if (gitMode || force || allProjects || longMode) {
      console.error("Error: 'tui' does not accept --git, --GIT, --force, --all-projects, or -l.");
      process.exit(1);
    }
    if (tuiList) {
      if (sharedTui || serverArg || tuiSession || targetDir !== process.cwd()) {
        console.error("Error: 'ocmux tui --list' does not accept --shared, --server, --session-id, or a directory.");
        process.exit(1);
      }
      cmdTuiList();
    } else if (tuiStatus) {
      if (serverArg || tuiSession) {
        console.error("Error: 'ocmux tui --status' does not accept --server or --session-id.");
        process.exit(1);
      }
      cmdTuiStatus(targetDir, sharedTui);
    } else if (tuiDetach) {
      if (serverArg || tuiSession) {
        console.error("Error: 'ocmux tui --detach' does not accept --server or --session-id.");
        process.exit(1);
      }
      cmdTuiDetach(targetDir, sharedTui);
    } else {
      p = cmdTui(targetDir, serverArg, sharedTui, tuiSession);
    }
  } else if (subcommand === 'session') {
    if (gitMode) {
      console.error("Error: '--git' and '--GIT' are only valid with 'serve'.");
      process.exit(1);
    }
    p = cmdSessionSwitch(targetDir, directRef, allProjects);
  } else if (subcommand === 'migrate') {
    if (targetDir !== process.cwd()) {
      console.error("Error: 'migrate' does not accept a directory path.");
      process.exit(1);
    }
    p = cmdMigrate(serverArg || DEFAULT_SERVER);
  } else if (subcommand === 'serve' || subcommand === 'new') {
    if (gitMode) {
      const flagLabel = gitMode === 'root' ? '--GIT' : '--git';
      targetDir = resolveGitDir(targetDir, gitMode === 'root', flagLabel);
    }
    p = cmdServeNew(targetDir, serverArg, force);
  } else {
    // Default: session switcher for the current project.
    if (gitMode) {
      console.error("Error: '--git' and '--GIT' are only valid with 'serve'.");
      process.exit(1);
    }
    p = cmdSessionSwitch(targetDir, null, allProjects);
  }

  return p.catch((err) => {
    // Already exiting (a command called process.exit — the test stub throws
    // EXIT:code). Swallow so the chain settles cleanly.
    if (err && err.message && err.message.startsWith('EXIT:')) return;
    console.error(err ? err.message : String(err));
    process.exit(1);
  });
}

if (require.main === module) {
  main();
}

module.exports = { main, checkServer, askYesNo, newestSessionId, configuredProjects, refreshTui, cmdTui, cmdTuiList, cmdTuiStatus, cmdTuiDetach, cmdList, cmdMigrate, windowFor, renderList, fmtClock, fmtDuration, fmtTokens, fmtCost, layoutCells, sessionInfoLines, centerIn, filterByPattern, newSearchState, handleSearch, searchFooter, sessionMenu, switchMenu, SWITCH_QUIT, SEARCH_HINT, sortModels, indexOfModel, BROWN, BAR_BG, LIGHT_YELLOW, QUESTION_BG };
