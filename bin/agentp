#!/usr/bin/env node

const http = require('http');
const fs = require('fs');
const path = require('path');
const os = require('os');
const crypto = require('crypto');
const readline = require('readline');
const child_process = require('child_process');
const { version } = require('../package.json');
const {
  sendToSession,
  listSessions,
  createSession,
  getSession,
  selectSession,
} = require('../lib/opencode');

const TGAGENTP_PORT_FILE = '/tmp/tgagentp-port';

function notifyAgentpGateway(port, server, text) {
  return new Promise((resolve, reject) => {
    const body = JSON.stringify({ text, server });
    const options = {
      hostname: '127.0.0.1',
      port,
      path: '/send',
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(body),
      },
    };
    const password = process.env.OPENCODE_SERVER_PASSWORD;
    if (password) {
      const username = process.env.OPENCODE_SERVER_USERNAME || 'opencode';
      options.headers['Authorization'] = 'Basic ' +
        Buffer.from(`${username}:${password}`).toString('base64');
    }
    const req = http.request(options, (res) => {
      let data = '';
      res.on('data', (chunk) => { data += chunk; });
      res.on('end', () => {
        if (res.statusCode === 200) {
          try {
            const result = JSON.parse(data);
            resolve(result.buffered || []);
          } catch {
            resolve([]);
          }
        } else {
          reject(new Error(`status ${res.statusCode}: ${data}`));
        }
      });
    });
    req.setTimeout(5000, () => {
      req.destroy();
      reject(new Error('Connection timed out'));
    });
    req.on('error', reject);
    req.write(body);
    req.end();
  });
}

function isFileLocked(filePath) {
  const lockPath = filePath + '.lock';
  try {
    if (!fs.existsSync(lockPath)) return false;
    const pid = parseInt(fs.readFileSync(lockPath, 'utf8').trim(), 10);
    if (isNaN(pid)) return false;
    // Check if process is still alive
    try {
      process.kill(pid, 0);
      return true; // Process exists, file is locked
    } catch (err) {
      // Process doesn't exist, lock is stale
      fs.unlinkSync(lockPath);
      return false;
    }
  } catch {
    return false;
  }
}

function lockFile(filePath) {
  const lockPath = filePath + '.lock';
  fs.writeFileSync(lockPath, String(process.pid));
}

function unlockFile(filePath) {
  const lockPath = filePath + '.lock';
  try {
    fs.unlinkSync(lockPath);
  } catch {
    // Ignore errors
  }
}

function generateTempFilename() {
  const now = new Date();
  const timestamp = now.getFullYear().toString() +
    String(now.getMonth() + 1).padStart(2, '0') +
    String(now.getDate()).padStart(2, '0') + '_' +
    String(now.getHours()).padStart(2, '0') +
    String(now.getMinutes()).padStart(2, '0');
  const hash = crypto.randomBytes(2).toString('hex').slice(0, 4);
  return path.join(os.tmpdir(), `agentp_deferred_${timestamp}_${hash}.tmp`);
}

// Poll interval for --defer waiting (ms). Overridable for tests.
const DEFER_POLL_MS = 250;

// Parse an `agentp_ticket <json>` reference from input text.
// The ticket may be wrapped in whitespace/newlines. Returns
// { ctime, path, defer } or null if input is not a ticket.
function parseDeferredTicket(text) {
  const trimmed = String(text).trim();
  if (!trimmed.startsWith('agentp_ticket')) return null;
  let data;
  try {
    data = JSON.parse(trimmed.slice('agentp_ticket'.length).trim());
  } catch {
    return null;
  }
  if (!data || typeof data.path !== 'string' || !data.path) return null;
  return {
    ctime: typeof data.ctime === 'string' ? data.ctime : null,
    path: data.path,
    defer: typeof data.defer === 'number' && data.defer > 0 ? data.defer : 0,
  };
}

// Format a deferred ticket for printing. `elapsed` is only included on
// re-prints; `defer` only when a timeout > 0 was requested. Pretty-printed
// JSON by default (easier to read/edit); pass `compact` for a single line.
function formatTicket(ticket, elapsed, compact) {
  const fields = { ctime: ticket.ctime, path: ticket.path };
  if (elapsed !== undefined) fields.elapsed = elapsed;
  if (ticket.defer > 0) fields.defer = ticket.defer;
  return 'agentp_ticket ' + (compact ? JSON.stringify(fields) : JSON.stringify(fields, null, 2));
}

// Read the deferred output file. Returns the answer string, or null if the
// answer is not ready yet (file missing, still locked, or still empty).
function readDeferredResult(filePath) {
  if (!fs.existsSync(filePath)) return null;
  if (isFileLocked(filePath)) return null;
  let content = '';
  try {
    content = fs.readFileSync(filePath, 'utf8');
  } catch {
    return null;
  }
  return content === '' ? null : content;
}

// Poll up to timeoutMs for a ready deferred result. Returns the answer or null.
async function waitForDeferredResult(filePath, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  for (;;) {
    const result = readDeferredResult(filePath);
    if (result !== null) return result;
    const remaining = deadline - Date.now();
    if (remaining <= 0) return null;
    await sleepMs(Math.min(DEFER_POLL_MS, remaining));
  }
}

function sleepMs(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function readAllStdin() {
  let text = '';
  const rl = readline.createInterface({ input: process.stdin });
  for await (const line of rl) {
    text += line + '\n';
  }
  rl.close();
  return text;
}

const HUMAN_ROW = '👤: —————————————————\n'
const AGENT_ROW = '🤖: —————————————————\n'
const FINAL_ROW = '    —————————————————\n';

async function main() {
  let serverBase = 'http://localhost:4096';
  let qaMode = false;
  let flushMode = false;
  let deferMode = false;
  let deferSeconds = 0;
  let deferChildMode = false;
  let onlineTicket = false;
  let promptFile = null;
  let outputFile = null;
  let sessionName = null;
  let newSession = false;
  // tgMode: false = disabled, 'auto' = auto-detect, true = explicit --tg
  let tgMode = null;

  const args = process.argv.slice(2);
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--version') {
      console.log(version);
      process.exit(0);
    } else if (args[i] === '--help') {
      console.error('Usage: agentp [options] [url]');
      console.error('');
      console.error('Pipe prompt text to an OpenCode session and get the assistant response on stdout.');
      console.error('');
      console.error('Options:');
      console.error('  --version   Show version');
      console.error('  --qa        Print the original prompt and answer with labels (useful as a filter)');
      console.error('  --defer [N] Deferred execution: submit prompt, get a ticket immediately');
      console.error('              (or wait up to N seconds for the answer and print it if it arrives)');
      console.error('              Pipe the ticket back to agentp --defer to retrieve the result later');
      console.error('  --onlineTicket');
      console.error('              Print deferred tickets on a single line (default: pretty-printed JSON)');
      console.error('  --tg        Forward the answer to Telegram via agentp gateway (error if unavailable)');
      console.error('  --no-tg     Do not forward to Telegram');
      console.error('  --flush     Flush tgagentp\'s recorded buffer without prepending it to output');
      console.error('  --getLast   Retrieve last N assistant answers (or QA pairs with --qa) from session history');
      console.error('  --session   Target a specific session by name (creates it if not found with --new)');
      console.error('  --new       Create a new session with the given title (requires --session)');
      console.error('  --help      Show this help message');
      console.error('');
      console.error('By default, --qa auto-detects tgagentp; standalone mode implies --no-tg.');
      console.error('--tg: error if tgagentp is unavailable; auto mode: silently degrade.');
      console.error('');
      console.error('When --qa is combined with --getLast, the output includes full QA pairs');
      console.error('(user prompt + assistant answer) with rulers, matching the recorded');
      console.error('context replay format. Without --qa, only the assistant answers are shown.');
      console.error('');
      console.error('--flush clears the tgagentp recorded buffer and also prevents the prepended');
      console.error('context from appearing in --qa output. Use it when you want fresh context.');
      console.error('');
      console.error('--session <name> targets a specific session by exact or partial name match.');
      console.error('If the session does not exist, agentp errors (use --new to create it).');
      console.error('--new creates a new session with the given title (does not match existing sessions).');
      console.error('');
      console.error('Arguments:');
      console.error('  url        OpenCode server URL or port number (default: 4096)');
      console.error('             Examples: 4096, http://localhost:4096, http://192.168.1.50:4096');
      console.error('             Tip: $(ocmux) expands to the URL of the current project\'s server.');
      console.error('');
      console.error('See also: tgagentp -- Telegram bridge (tgagentp --help), ocmux -- manage OpenCode tmux sessions (ocmux --help)');
      console.error('');
      console.error('Examples:');
      console.error('  printf "Summarize this file" | agentp');
      console.error('  cat prompt.txt | agentp $(ocmux)            # talk to current project\'s server');
      console.error('  cat prompt.txt | agentp --session "My Task" $(ocmux)');
      console.error('  cat prompt.txt | agentp --session "New Task" --new $(ocmux)');
      console.error('  # Vim/Neovim filter, preserving prompt + answer:');
      console.error("  :'<,'>!agentp --qa $(ocmux)");
      console.error('  # Retrieve last 3 assistant answers:');
      console.error('  agentp --getLast 3');
      console.error('  agentp --getLast 3 --qa                     # full QA pairs with rulers');
      console.error('  agentp --getLast 1 4096');
      process.exit(0);
    } else if (args[i] === '--qa') {
      qaMode = true;
    } else if (args[i] === '--defer') {
      deferMode = true;
      const next = args[i + 1];
      if (next !== undefined && /^\d+$/.test(next)) {
        deferSeconds = parseInt(next, 10);
        i++;
      } else {
        deferSeconds = 0;
      }
    } else if (args[i] === '--defer-child') {
      deferChildMode = true;
    } else if (args[i] === '--onlineTicket') {
      onlineTicket = true;
    } else if (args[i] === '--prompt-file') {
      i++;
      promptFile = args[i];
    } else if (args[i] === '--output-file') {
      i++;
      outputFile = args[i];
    } else if (args[i] === '--flush') {
      flushMode = true;
    } else if (args[i] === '--session') {
      i++;
      sessionName = args[i];
      if (!sessionName) {
        console.error('Error: --session requires a session name');
        process.exit(1);
      }
    } else if (args[i] === '--new') {
      newSession = true;
    } else if (args[i] === '--getLast') {
      i++;
      const nStr = args[i];
      if (!nStr || !/^\d+$/.test(nStr)) {
        console.error('Error: --getLast requires a number (e.g. --getLast 5)');
        process.exit(1);
      }
      const n = parseInt(nStr, 10);
      try {
        const sessions = await listSessions(serverBase);
        if (!sessions || sessions.length === 0) {
          console.error('No sessions found.');
          process.exit(1);
        }
        const sorted = sessions
          .filter(s => s.time && (s.time.updated || s.time.created))
          .sort((a, b) => {
            const aTime = (a.time && a.time.updated) || (a.time && a.time.created) || 0;
            const bTime = (b.time && b.time.updated) || (b.time && b.time.created) || 0;
            return bTime - aTime;
          });
        const sessionId = sorted[0].id;

        function buildPairsFromMessages(messages) {
          const pairs = [];
          let cur = null;
          for (const raw of messages) {
            // Normalize: export gives {role, parts: [{type, text}]}, SQLite gives {role, text}
            const m = raw.parts ? raw : { role: raw.role, parts: [{ type: 'text', text: raw.text }] };
            const role = m.role;
            const text = (m.parts || []).filter(p => p.type === 'text').map(p => p.text).join('').trim();
            if (!text) continue;
            if (role === 'user') {
              if (cur) pairs.push(cur);
              cur = { prompt: text, answer: '' };
            } else if (role === 'assistant' && cur) {
              if (cur.answer) cur.answer += '\n';
              cur.answer += text;
            }
          }
          // Don't push incomplete pair (no answer yet)
          return pairs;
        }

        function formatPairs(pairs) {
          return pairs.map(p =>
            HUMAN_ROW + p.prompt + '\n' + AGENT_ROW + p.answer + '\n' + FINAL_ROW
          ).join('\n');
        }

        const formatAsQa = qaMode || args.includes('--qa');
        function extractAnswers(pairs) {
          return pairs.map(p => p.answer);
        }
        let output = '';
        try {
          const raw = child_process.execFileSync('opencode', ['export', sessionId], { encoding: 'utf8', maxBuffer: 50 * 1024 * 1024 });
          const jsonStart = raw.indexOf('{');
          const body = jsonStart >= 0 ? raw.slice(jsonStart) : raw;
          const exportData = JSON.parse(body);
          const messages = exportData.messages || [];
          const pairs = buildPairsFromMessages(messages);
          const lastN = pairs.slice(-n);
          output = formatAsQa ? formatPairs(lastN) : extractAnswers(lastN).join('\n');
        } catch {
          // export JSON is malformed (opencode bug);
          // fall back to SQLite
          const home = process.env.HOME || process.env.USERPROFILE || '';
          const dbCandidates = [
            `${home}/.local/share/opencode/opencode.db`,
            `${home}/Library/Application Support/opencode/opencode.db`,
            `${home}/.opencode/opencode.db`,
          ];
          let dbPath = null;
          for (const p of dbCandidates) {
            try { fs.accessSync(p); dbPath = p; break; } catch {}
          }
          if (dbPath) {
            const sql = `SELECT m.data->>'role' as role, group_concat(p.data->>'text', '') as text FROM message m JOIN part p ON p.message_id = m.id WHERE m.session_id = '${sessionId.replace(/'/g, "''")}' AND p.data->>'type' = 'text' AND m.data->>'role' IN ('user','assistant') GROUP BY m.id ORDER BY m.time_created ASC`;
            const out = child_process.execFileSync('sqlite3', ['-json', dbPath, sql], { encoding: 'utf8', maxBuffer: 50 * 1024 * 1024 });
            const messages = JSON.parse(out);
            const pairs = buildPairsFromMessages(messages);
            const lastN = pairs.slice(-n);
            output = formatAsQa ? formatPairs(lastN) : extractAnswers(lastN).join('\n');
          }
        }
        if (!output) {
          console.error(formatAsQa ? 'No complete prompt-answer pairs found in session history.' : 'No assistant answers found in session history.');
          process.exit(1);
        }
        process.stdout.write(output);
        if (!output.endsWith('\n')) process.stdout.write('\n');
      } catch (err) {
        console.error('Error retrieving session history:', err.message);
        process.exit(1);
      }
      return;
    } else if (args[i] === '--tg') {
      tgMode = true;
    } else if (args[i] === '--no-tg') {
      tgMode = false;
    } else if (args[i].includes('://')) {
      serverBase = args[i].replace(/\/+$/, '');
    } else if (/^\d+$/.test(args[i])) {
      serverBase = 'http://localhost:' + args[i];
    } else if (args[i].startsWith('--')) {
      console.error(`Error: unknown option '${args[i]}'`);
      console.error(`Usage: agentp [options] [url]`);
      console.error(`Try 'agentp --help' for more information.`);
      process.exit(1);
    } else {
      console.error(`Error: unexpected argument '${args[i]}'`);
      process.exit(1);
    }
  }

  // Resolve default: --qa → auto-detect, standalone → disabled
  if (tgMode === null) {
    tgMode = qaMode ? 'auto' : false;
  }

  // Pre-send: probe tgagentp gateway if enabled
  let tgPort = null;
  if (tgMode) {
    try {
      tgPort = fs.readFileSync(TGAGENTP_PORT_FILE, 'utf8').trim();
      if (!tgPort || !/^\d+$/.test(tgPort)) tgPort = null;
    } catch {
      tgPort = null;
    }
    if (!tgPort && tgMode === true) {
      console.error('Error: tgagentp gateway not found. Is tgagentp running?');
      process.exit(1);
    }
    // auto mode: tgPort stays null → silently skip tgagentp
  }

  const promptText = await readAllStdin();

  // Handle --defer mode
  if (deferMode) {
    // Check if stdin is a deferred ticket
    const ticket = parseDeferredTicket(promptText);

    if (ticket) {
      // This is a ticket — retrieve the result. The --defer argument is
      // ignored; the ticket's own "defer" timeout is used instead (default 0).
      const deferredPath = ticket.path;

      if (!fs.existsSync(deferredPath)) {
        process.stdout.write(`Error: deferred file not found: ${deferredPath}\n`);
        process.exit(1);
      }

      const result = await waitForDeferredResult(deferredPath, ticket.defer * 1000);

      if (result !== null) {
        // Answer available — return it and remove the temp file
        try {
          fs.unlinkSync(deferredPath);
        } catch (err) {
          process.stdout.write(`Error reading deferred file: ${err.message}\n`);
          process.exit(1);
        }
        try { fs.unlinkSync(deferredPath + '.lock'); } catch {}
        process.stdout.write(result);
        process.exit(0);
      }

      // Answer not available yet — re-print the ticket with updated elapsed
      const elapsed = ticket.ctime
        ? Math.max(0, Math.floor((Date.now() - Date.parse(ticket.ctime)) / 1000))
        : 0;
      process.stdout.write(formatTicket(ticket, elapsed, onlineTicket) + '\n');
      process.exit(0);
    }

    // This is a regular prompt — create deferred execution
    const tempPath = generateTempFilename();
    const promptTempPath = tempPath + '.prompt';

    // Write prompt to temp file for child process
    fs.writeFileSync(promptTempPath, promptText);

    // Create and lock the output file
    fs.writeFileSync(tempPath, '');
    lockFile(tempPath);

    const newTicket = {
      ctime: new Date().toISOString(),
      path: tempPath,
      defer: deferSeconds,
    };

    // Spawn detached child process
    const childArgs = [
      __filename,
      '--defer-child',
      '--prompt-file', promptTempPath,
      '--output-file', tempPath,
    ];

    // Pass through other flags
    if (qaMode) childArgs.push('--qa');
    if (tgMode === true) childArgs.push('--tg');
    if (tgMode === false) childArgs.push('--no-tg');
    if (flushMode) childArgs.push('--flush');
    if (sessionName) {
      childArgs.push('--session', sessionName);
      if (newSession) childArgs.push('--new');
    }
    childArgs.push(serverBase);

    const child = child_process.spawn(process.execPath, childArgs, {
      detached: true,
      stdio: 'ignore',
    });
    child.unref();

    // If a timeout was given, block until the answer arrives or the timeout
    // expires. Return the response when it arrives; otherwise print a ticket.
    if (deferSeconds > 0) {
      const result = await waitForDeferredResult(tempPath, deferSeconds * 1000);
      if (result !== null) {
        try {
          fs.unlinkSync(tempPath);
        } catch (err) {
          process.stdout.write(`Error reading deferred file: ${err.message}\n`);
          process.exit(1);
        }
        try { fs.unlinkSync(tempPath + '.lock'); } catch {}
        process.stdout.write(result);
        process.exit(0);
      }
    }

    // Output the deferred ticket
    process.stdout.write(formatTicket(newTicket, undefined, onlineTicket) + '\n');
    process.exit(0);
  }

  // Handle --defer-child mode (child process)
  let actualPromptText = promptText;
  if (deferChildMode && promptFile) {
    try {
      actualPromptText = fs.readFileSync(promptFile, 'utf8');
      fs.unlinkSync(promptFile);
    } catch (err) {
      const errMsg = `Error reading prompt file: ${err.message}\n`;
      if (outputFile) { fs.writeFileSync(outputFile, errMsg); unlockFile(outputFile); }
      process.stdout.write(errMsg);
      process.exit(1);
    }
  }

  // Wrap main processing in try-catch for deferChildMode to write errors to output file
  let tgError = null;
  async function runMain() {
    // Find most recent session or create one
    let sessions;
    try {
      sessions = await listSessions(serverBase);
    } catch (err) {
      throw new Error(`Error connecting to server: ${err.message}`);
    }

    let sessionId = null;

    if (sessionName) {
      // Find session by name
      const matches = sessions.filter(s => {
        const title = s.title || s.slug || s.id;
        return title.toLowerCase() === sessionName.toLowerCase();
      });
      if (matches.length === 0) {
        // Try partial match
        const partial = sessions.filter(s => {
          const title = s.title || s.slug || s.id;
          return title.toLowerCase().includes(sessionName.toLowerCase());
        });
        if (partial.length === 1) {
          sessionId = partial[0].id;
        } else if (partial.length > 1) {
          throw new Error(`Error: multiple sessions match "${sessionName}"`);
        } else if (newSession) {
          // Create new session
          try {
            const session = await createSession(serverBase, sessionName);
            sessionId = session.id;
            await selectSession(serverBase, sessionId);
          } catch (err) {
            throw new Error(`Error creating session: ${err.message}`);
          }
        } else {
          throw new Error(`Error: no session found matching "${sessionName}"`);
        }
      } else {
        sessionId = matches[0].id;
      }
    } else if (sessions && sessions.length > 0) {
      const sorted = sessions
        .filter(s => s.time && (s.time.updated || s.time.created))
        .sort((a, b) => {
          const aTime = (a.time && a.time.updated) || (a.time && a.time.created) || 0;
          const bTime = (b.time && b.time.updated) || (b.time && b.time.created) || 0;
          return bTime - aTime;
        });
      if (sorted.length > 0) sessionId = sorted[0].id;
    }

    if (!sessionId) {
      try {
        const session = await createSession(serverBase, 'agentp');
        sessionId = session.id;
      } catch (err) {
        throw new Error(`Error creating session: ${err.message}`);
      }
    }

    let answer;
    try {
      answer = await sendToSession(serverBase, sessionId, actualPromptText);
    } catch (err) {
      throw new Error(`Error sending prompt: ${err.message}`);
    }

    // Build the message to send to Telegram (QA pair with rulers)
    let tgMessage = answer;
    if (qaMode) {
      tgMessage = HUMAN_ROW + actualPromptText + AGENT_ROW + answer;
      if (!answer.endsWith('\n')) tgMessage += '\n';
      tgMessage += FINAL_ROW;
    }

    // Post-send: notify tgagentp, get recorded context back
    let buffered = [];
    if (tgPort) {
      try {
        buffered = await notifyAgentpGateway(tgPort, serverBase, tgMessage);
      } catch (err) {
        tgError = err;
      }
    }

    // Build output (prepend recorded context if any, unless --flush)
    let output = '';
    if (qaMode) {
      if (!flushMode && buffered.length > 0) {
        for (const msg of buffered) {
          const row = msg.role === 'user' ? HUMAN_ROW : AGENT_ROW;
          output += row + msg.text + '\n';
        }
      }
      output += tgMessage;
    } else {
      output = tgMessage;
      if (!tgMessage.endsWith('\n')) output += '\n';
    }

    return output;
  }

  // Execute main processing with error handling for child mode
  let output = '';
  try {
    output = await runMain();
  } catch (err) {
    const errMsg = err.message + '\n';
    if (deferChildMode && outputFile) {
      fs.writeFileSync(outputFile, errMsg);
      unlockFile(outputFile);
    } else {
      console.error(err.message);
    }
    process.exit(1);
  }

  // Write output to file (child mode) or stdout (normal mode)
  let finalOutput = output;
  if (deferChildMode && outputFile) {
    try {
      fs.writeFileSync(outputFile, output);
      unlockFile(outputFile);
    } catch (err) {
      const errMsg = `Error writing output file: ${err.message}\n`;
      try { fs.writeFileSync(outputFile, errMsg); } catch {}
      unlockFile(outputFile);
      process.exit(1);
    }
  } else {
    process.stdout.write(output);
  }

  // Warnings at the end (stderr)
  if (tgError && tgMode === true) {
    process.stderr.write('\n');
    process.stderr.write(`⚠️  Telegram notification failed: ${tgError.message}\n`);
  }
  if (!process.env.OPENCODE_SERVER_PASSWORD) {
    process.stderr.write('\n');
    process.stderr.write('🔓 ⚠️  Server is not password-protected! Set OPENCODE_SERVER_PASSWORD for better security.\n');
  }
}

if (require.main === module) {
  main().catch((err) => {
    console.error('Error:', err.message);
    process.exit(1);
  });
}

module.exports = { main, notifyAgentpGateway, readAllStdin, parseDeferredTicket, formatTicket, waitForDeferredResult };

